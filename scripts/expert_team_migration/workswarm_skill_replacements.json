      "native_tools": ["generate_visual"],
      "runtime_prerequisites": [
        "Enable Visual processing and configure VISUAL_GEN_API_KEY, VISUAL_GEN_API_BASE and VISUAL_GEN_MODEL_NAME; a keyless vLLM-Omni backend only requires its API URL.",
        "Use a writable save_dir inside the task workspace, require a real raster output, and pass the validated local path to the team leader as an internal artifact.",
        "For photo-guided generation, configure ModelArk/Seedream, DashScope/Qwen-Image, vLLM-Omni, or an OpenRouter-compatible multimodal image model. MiniMax image generation rejects reference images."
      ],
      "call_rewrites": [
        {
          "legacy": "Run generate_seedream.py using ~/.openclaw/.xiaoyienv, or call Huawei invoke with Seedream functionName and bundleName.",
          "replacement": "Call generate_visual(prompt, aspect_ratio, resolution, save_dir, reference_image_paths). Pass the actual uploaded paths for photo-guided work, reject error or remote-only results, and consume only a validated local raster path."
        }
      ],
      "persona_instruction": "Compile a concrete visual brief first, then call generate_visual with the final prompt and a task-workspace save_dir. For room/storage, renovation, styling, product or portrait tasks with uploaded images, you MUST pass their actual paths in reference_image_paths; never silently downgrade to text-to-image. A requested generated image is complete only when a readable PNG/JPEG/WebP/GIF exists locally; never substitute a hand-written SVG, HTML drawing, PIL illustration or browser screenshot and claim image generation succeeded.",
      "known_gaps": [
        "Reference-image support depends on the configured provider/model. ModelArk/Seedream, DashScope/Qwen-Image and vLLM-Omni receive explicit reference_image_uris; OpenRouter-compatible providers receive multimodal message content; MiniMax rejects the request instead of silently running text-to-image.",
        "Seedream-specific Lite/Pro routing, max_images and XiaoYi point accounting must not be copied into the converted persona."
      ]
    },
