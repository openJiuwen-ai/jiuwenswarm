  "capability_replacements": {
    "web_research": {
      "portable_skill_id": "workswarm-web-research",
      "legacy_skill_ids": ["xiaoyi-web-search-win"],
      "strategy": "native_tools",
      "native_tools": ["free_search", "fetch_webpage"],
      "runtime_prerequisites": [
        "Enable FREE_SEARCH_DDG_ENABLED or FREE_SEARCH_BING_ENABLED so free_search is registered in the Team runtime.",
        "Allow outbound HTTPS for result discovery and authoritative-page fetching.",
        "Treat search snippets only as discovery hints; call fetch_webpage for claims that require source verification."
      ],
      "call_rewrites": [
        {
          "legacy": "Run xiaoyi-web-search-win/scripts/search.js through CLAW_NODE_EXE and the np://claw-skill proxy.",
          "replacement": "Call free_search(query, max_results, timeout_seconds), then call fetch_webpage(url, max_chars, timeout_seconds) for selected primary sources."
        }
      ],
      "persona_instruction": "Use free_search only when current external facts can change the answer. Treat its snippets as discovery evidence, fetch the selected authoritative page with fetch_webpage, retain source date and scope, and return a clearly marked partial result when search or fetch is unavailable.",
      "known_gaps": []
    },
    "image_understanding": {
      "portable_skill_id": "workswarm-image-understanding",
      "legacy_skill_ids": ["xiaoyi-image-understanding"],
      "strategy": "native_tools",
      "native_tools": ["visual_question_answering"],
      "runtime_prerequisites": [
        "Configure VISION_API_KEY, VISION_API_BASE and VISION_MODEL_NAME, or their models.vision equivalents.",
        "Ensure uploaded image paths or URLs remain readable from the member runtime."
      ],
      "call_rewrites": [
        {
          "legacy": "Run scripts/image_understanding.py --image ... --prompt ... with ~/.openclaw/.xiaoyienv credentials.",
          "replacement": "Call visual_question_answering(image_path_or_url, question). For multiple images, call once per image and consolidate only explicit observations."
        }
      ],
      "persona_instruction": "Call visual_question_answering with the actual uploaded image path and a question limited to observable objects, zones, clutter and circulation. Separate confirmed observations from uncertainty; never infer private facts or unmeasured dimensions.",
      "known_gaps": [
        "The native tool accepts one image per call; the converter must preserve multi-image semantics by repeated calls and explicit consolidation."
      ]
    },
    "image_generation": {
      "portable_skill_id": "workswarm-image-generation",
      "legacy_skill_ids": [
        "seedream-image_gen",
        "seedream-image-gen",
        "seedream-image-gen-win"
      ],
      "legacy_aliases": ["xiaoyi-image-gen"],
      "strategy": "native_tools",
      "native_tools": ["generate_image"],
      "runtime_prerequisites": [
        "Configure IMAGE_GEN_API_KEY, IMAGE_GEN_API_BASE and IMAGE_GEN_MODEL_NAME, or their models.image_gen equivalents.",
        "Use a writable save_dir inside the task workspace and pass the returned path to the team leader as an internal artifact."
      ],
      "call_rewrites": [
        {
          "legacy": "Run generate_seedream.py using ~/.openclaw/.xiaoyienv, or call Huawei invoke with Seedream functionName and bundleName.",
          "replacement": "Call generate_image(prompt, size, quality, save_dir) and consume the returned local image path."
        }
      ],
      "persona_instruction": "Compile a concrete visual brief first, then call generate_image with the final prompt and a task-workspace save_dir. Treat the returned local file as an internal team artifact; the leader decides whether it is embedded in the final HTML or sent as a final deliverable.",
      "known_gaps": [
        "The current native generate_image signature is text-to-image only and does not accept reference images. Photo-guided editing from the XiaoYi Seedream Skills is not equivalent; use visual_question_answering to derive a text brief and label the result as a concept image until a verified reference-image generator exists.",
        "Seedream-specific Lite/Pro routing, max_images and XiaoYi point accounting must not be copied into the converted persona."
      ]
    },
    "video_generation": {
      "portable_skill_id": "workswarm-video-generation",
      "legacy_skill_ids": ["seedance-video-gen-win"],
      "legacy_aliases": ["xiaoyi-video-gen"],
      "strategy": "native_tools",
      "native_tools": ["generate_video", "check_video_status"],
      "runtime_prerequisites": [
        "Configure VIDEO_API_KEY, VIDEO_API_BASE and VIDEO_MODEL_NAME, or their models.video_gen equivalents.",
        "Use a configured backend that supports the requested text, first-frame or reference-image mode.",
        "Persist the returned job_id and poll it with check_video_status instead of resubmitting the generation request."
      ],
      "call_rewrites": [
        {
          "legacy": "Call Huawei invoke with seedanceMiniTask, then repeatedly invoke seedanceMiniTaskQuery using bundleName.",
          "replacement": "Call generate_video(prompt, aspect_ratio, resolution, duration_seconds, first_frame_path, generate_audio, save_dir, reference_image_paths, reference_mode). If it returns a job_id, call check_video_status(job_id, save_dir) until terminal status."
        }
      ],
      "persona_instruction": "After the existing user-confirmation gate, submit exactly one generate_video call. If the result contains a running job_id, retain it and poll with check_video_status; never resubmit merely because generation is still running. Return the downloaded local file as an internal artifact to the leader.",
      "known_gaps": [
        "Available reference modes and duration limits depend on the configured WorkSwarm video backend and must be checked at runtime."
      ]
    }
  },
