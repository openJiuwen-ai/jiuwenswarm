      "call_rewrites": [
        {
          "legacy": "Run scripts/image_understanding.py --image ... --prompt ... with ~/.openclaw/.xiaoyienv credentials.",
          "replacement": "Call visual_question_answering(image_path_or_url, question). For multiple images, call once per image and consolidate only explicit observations."
        }
      ],
      "persona_instruction": "Call visual_question_answering with the actual uploaded image path and a question limited to observable objects, zones, clutter and circulation. Separate confirmed observations from uncertainty; never infer private facts or unmeasured dimensions.",
      "known_gaps": [
        "The native tool accepts one image per call; the converter must preserve multi-image semantics by repeated calls and explicit consolidation."
      ]
    },
