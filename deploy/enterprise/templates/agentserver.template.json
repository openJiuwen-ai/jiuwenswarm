{
  "type": "config_sync",
  "metadata": {
    "request_id": "default",
    "session_id": null,
    "user_id": "default",
    "bot_id": "default",
    "extra": {
      "group_id": "default"
    }
  },
  "rawdata": {
    "containers": [
      {
        "container_id": "c-agentserver",
        "name": "<<AGENT_SERVER_NAME>>",
        "image": "<<AGENT_SERVER_IMAGE>>",
        "imagePullPolicy": "IfNotPresent",
        "ports": [
          {
            "name": "sse",
            "containerPort": <<AGENT_SERVER_PORT>>
          }
        ],
        "envFrom": [
          {
            "secretRef": {
              "name": "<<SECRET_CM_NAME>>"
            }
          },
          {
            "configMapRef": {
              "name": "<<AGENT_SERVER_ENV_CM_NAME>>"
            }
          }
        ],
        "securityContext": {
          "runAsUser": 0,
          "runAsGroup": 0
        },
        "readinessProbe": {
          "httpGet": {
            "path": "/api/v1/health",
            "port": <<AGENT_SERVER_PORT>>
          },
          "initialDelaySeconds": 5,
          "periodSeconds": 10
        },
        "volumeMounts": [
          {
            "name": "hp-code",
            "mountPath": "/app/jiuwenswarm"
          },
          {
            "name": "hp-rt-foundation",
            "mountPath": "/usr/local/lib/python3.11/site-packages/openjiuwen_runtime/foundation"
          },
          {
            "name": "hp-rt-management",
            "mountPath": "/usr/local/lib/python3.11/site-packages/openjiuwen_runtime/management"
          },
          {
            "name": "hp-openjiuwen",
            "mountPath": "/usr/local/lib/python3.11/site-packages/openjiuwen"
          },
          {
            "name": "data",
            "mountPath": "<<AGENT_SERVER_HOME>>/.jiuwenswarm"
          },
          {
            "name": "agentserver-config",
            "mountPath": "/root/.jiuwenswarm/config/config.yaml",
            "subPath": "config.yaml"
          }
        ]
      },
      {
        "container_id": "c-jiuwenbox",
        "name": "<<JIUWENBOX_NAME>>",
        "image": "<<JIUWENBOX_IMAGE>>",
        "imagePullPolicy": "IfNotPresent",
        "ports": [
          {
            "containerPort": <<JIUWENBOX_PORT>>
          }
        ],
        "env": [
          {
            "name": "JIUWENBOX_LISTEN",
            "value": "http://0.0.0.0:<<JIUWENBOX_PORT>>"
          },
          {
            "name": "JIUWENBOX_POLICY_PATH",
            "value": "<<JIUWENBOX_POD_PKG_PATH>>/configs/enterprise-policy.yaml"
          },
          {
            "name": "TZ",
            "value": "<<TIMEZONE>>"
          }
        ],
        "securityContext": {
          "privileged": true,
          "capabilities": {
            "add": [
              "SYS_ADMIN",
              "NET_ADMIN"
            ]
          },
          "seccompProfile": {
            "type": "Unconfined"
          },
          "appArmorProfile": {
            "type": "Unconfined"
          }
        },
        "readinessProbe": {
          "tcpSocket": {
            "port": <<JIUWENBOX_PORT>>
          },
          "initialDelaySeconds": 10,
          "periodSeconds": 5
        },
        "volumeMounts": [
          {
            "name": "hp-cgroup",
            "mountPath": "/sys/fs/cgroup"
          },
          {
            "name": "hp-jiuwenbox",
            "mountPath": "/usr/local/lib/python3.11/site-packages/jiuwenbox"
          },
          {
            "name": "data",
            "mountPath": "<<JIUWENBOX_HOME>>/.jiuwenswarm"
          }
        ]
      }
    ],
    "templates": [
      {
        "template_id": "default",
        "template_name": "default",
        "main_container_id": "c-agentserver",
        "sidecar_container_ids": [
          "c-jiuwenbox"
        ],
        "pod_name": "<<AGENT_SERVER_NAME>>",
        "namespace": "<<NAMESPACE>>",
        "nodeName": "<<CURRENT_NODE_NAME>>",
        "sse_path": "/api/v1/events/stream",
        "scope_concurrency": 400,
        "pod_concurrency": 200,
        "session_ttl": 60,
        "pod_ttl": 180,
        "min_idle_pods": 1,
        "ready_timeout": 240,
        "volumes": [
          {
            "name": "hp-code",
            "hostPath": {
              "path": "<<CLAW_CODE_PATH>>",
              "type": "Directory"
            }
          },
          {
            "name": "hp-rt-foundation",
            "hostPath": {
              "path": "<<RUNTIME_CODE_PATH>>/foundation/openjiuwen_runtime/foundation",
              "type": "Directory"
            }
          },
          {
            "name": "hp-rt-management",
            "hostPath": {
              "path": "<<RUNTIME_CODE_PATH>>/management/openjiuwen_runtime/management",
              "type": "Directory"
            }
          },
          {
            "name": "hp-openjiuwen",
            "hostPath": {
              "path": "<<CORE_CODE_PATH>>/openjiuwen",
              "type": "Directory"
            }
          },
          {
            "name": "data",
            "persistentVolumeClaim": {
              "claimName": "<<CLAW_PVC>>"
            }
          },
          {
            "name": "agentserver-config",
            "configMap": {
              "name": "<<GATEWAY_CONFIG_MAP_NAME>>"
            }
          },
          {
            "name": "hp-cgroup",
            "hostPath": {
              "path": "/sys/fs/cgroup",
              "type": "Directory"
            }
          },
          {
            "name": "hp-jiuwenbox",
            "hostPath": {
              "path": "<<CLAW_CODE_PATH>>/jiuwenbox/src/jiuwenbox",
              "type": "Directory"
            }
          }
        ]
      }
    ],
    "scopes": [
      {
        "scope_id": "default",
        "index": 100,
        "template_id": "default",
        "routing_rules": ""
      }
    ]
  }
}