# All values MUST NOT have quotes, no trailing spaces at line end
LOG_ROOT_PATH=/root/.logs
EXTENSION_DIRS=<<CLAW_POD_CODE_PATH>>/packages/jiuwenclaw-ee/gateway/extensions
PIP_EXTRA_ARGS=<<PIP_EXTRA_ARGS>>
NAMESPACE=<<NAMESPACE>>
JIUWENSWARM_EDITION=<<JIUWENSWARM_EDITION>>
TZ=<<TIMEZONE>>
JINA_READER_ENDPOINT=<<JINA_READER_ENDPOINT>>
HTTP_PROXY=<<HTTP_PROXY>>
HTTPS_PROXY=<<HTTPS_PROXY>>
NO_PROXY=<<NO_PROXY>>
FETCH_WEBPAGE_TIMEOUT=<<FETCH_WEBPAGE_TIMEOUT>>
FETCH_WEBPAGE_TOTAL_TIMEOUT=<<FETCH_WEBPAGE_TOTAL_TIMEOUT>>

# Runtime Orchestrator Configuration
AGENT_SERVER_IMAGE=<<AGENT_SERVER_IMAGE>>
AGENT_SERVER_PORT=18092
AGENT_SERVER_CONTAINER_NAME=<<AGENT_SERVER_NAME>>
AGENT_SERVER_PORT_NAME=http1
AGENT_SERVER_IMAGE_PULL_POLICY=IfNotPresent
AGENT_SERVER_CUSTOM_ENVS=<<AGENT_SERVER_CUSTOM_ENVS>>
AGENT_SERVER_CONFIGMAP_NAME=<<GATEWAY_CONFIG_MAP_NAME>>
AGENT_SERVER_HOME=<<AGENT_SERVER_HOME>>

# StreamingToolExecutor.wait_all wall-clock timeout (seconds).
# <=0 disables timeout. Forwarded to AgentServer pods.
STREAMING_TOOL_WAIT_TIMEOUT_S=<<STREAMING_TOOL_WAIT_TIMEOUT_S>>

# use extension config to construct rail
AGENT_EXTRA_RAILS=<<AGENT_EXTRA_RAILS>>

# use extension modules to register extra tools (register_tools() factories)
AGENT_EXTRA_TOOLS=<<AGENT_EXTRA_TOOLS>>

# ServiceManager Configuration
AGENT_SERVER_MIN_IDLE_SERVICES=1
AGENT_SERVER_MAX_SERVICES=20
AGENT_SERVER_SERVICE_CONCURRENCY=<<AGENT_SERVER_SERVICE_CONCURRENCY>>
AGENT_SERVER_SERVICE_TTL=180
AGENT_SERVER_AUTOSCALE_INTERVAL=5

# AccessConfig Configuration
AGENT_SERVER_MESSAGE_TIMEOUT=300

# SessionConfig Configuration
AGENT_SERVER_SESSION_CONCURRENCY=<<AGENT_SERVER_SESSION_CONCURRENCY>>
AGENT_SERVER_SESSION_TTL=<<AGENT_SERVER_SESSION_TTL>>

# Bucket count for bot_id before default service_id/agent_id assembly; 0 = no bucketing (raw bot_id)
AGENT_BOT_ID_GROUP_NUM=<<AGENT_BOT_ID_GROUP_NUM>>

# K8s NFS Configuration
# CLAW_MOUNT_TYPE=<<CLAW_MOUNT_TYPE>>
# CLAW_PVC=<<CLAW_PVC>>
# CLAW_NFS_SERVER=<<NFS_SERVER_ADDR>>
# CLAW_NFS_PATH=<<NFS_SHARE_PATH>>/jiuwenclaw

# K8s hostPath Configuration (for mounting host code directory)
MODE=<<MODE>>
CLAW_CODE_PATH=<<CLAW_CODE_PATH>>
CLAW_POD_CODE_PATH=<<CLAW_POD_CODE_PATH>>
JIUWENBOX_POD_PKG_PATH=<<JIUWENBOX_POD_PKG_PATH>>
RUNTIME_CODE_PATH=<<RUNTIME_CODE_PATH>>
RUNTIME_POD_PKG_PATH=<<RUNTIME_POD_PKG_PATH>>
CORE_CODE_PATH=<<CORE_CODE_PATH>>
CORE_POD_PKG_PATH=<<CORE_POD_PKG_PATH>>

NODE_NAME=<<CURRENT_NODE_NAME>>

# K8s Resource Configuration
AGENT_SERVER_CPU_REQUEST=<<AGENT_SERVER_CPU_REQUEST>>
AGENT_SERVER_MEMORY_REQUEST=<<AGENT_SERVER_MEMORY_REQUEST>>
AGENT_SERVER_CPU_LIMIT=<<AGENT_SERVER_CPU_LIMIT>>
AGENT_SERVER_MEMORY_LIMIT=<<AGENT_SERVER_MEMORY_LIMIT>>

# K8s Pod Readiness Probe Configuration
AGENT_SERVER_KUBECONFIG=
AGENT_SERVER_READINESS_INITIAL_DELAY=5
AGENT_SERVER_READINESS_PERIOD=10
AGENT_SERVER_READY_TIMEOUT=300
AGENT_SERVER_READY_POLL_INTERVAL=2

# Model Configuration
MODEL_PROVIDER=<<MODEL_PROVIDER>>
MODEL_NAME=<<MODEL_NAME>>
API_BASE=<<API_BASE>>
LLM_SSL_VERIFY=False

# Gateway Configuration
LOG_MASK_ENABLED=<<LOG_MASK_ENABLED>>
LOG_TO_FILE_ENABLED=<<LOG_TO_FILE_ENABLED>>
HEARTBEAT_ENABLED=FALSE
SYNC_CONFIG_ON_STARTUP=FALSE
GATEWAY_CLAW_WS_PING_INTERVAL=<<GATEWAY_CLAW_WS_PING_INTERVAL>>
GATEWAY_CLAW_WS_PING_TIMEOUT=<<GATEWAY_CLAW_WS_PING_TIMEOUT>>
JIUWENSWARM_REQUEST_EXT_FORWARD_HEADERS=<<JIUWENSWARM_REQUEST_EXT_FORWARD_HEADERS>>

# Websocket Configuration
WEB_HOST=0.0.0.0
WEB_PORT=<<WEB_PORT>>
GATEWAY_WS_PORT=<<GATEWAY_WS_PORT>>
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=<<GATEWAY_HTTP_PORT>>
GATEWAY_WEB_HTTP_PORT=<<GATEWAY_WEB_HTTP_PORT>>

# Enterprise Web: browser WS on app_enterprise_web; Gateway WS client to /gateway
ENTERPRISE_WEB_ENABLED=true
ENTERPRISE_WEB_GATEWAY_URL=ws://<<WEB_NAME>>:<<WEB_WS_PORT>>/gateway
# Enterprise Web: max chars for tool results in chat UI (0 = no truncation)
TOOL_RESULT_DISPLAY_MAX_CHARS=<<TOOL_RESULT_DISPLAY_MAX_CHARS>>


# Gateway database
GATEWAY_DB_TYPE=<<DB_TYPE>>
GATEWAY_DB_HOST=<<DB_HOST>>
GATEWAY_DB_PORT=<<DB_PORT>>
GATEWAY_DB_USER=<<GATEWAY_DB_USER>>
GATEWAY_DB_NAME=<<GATEWAY_DB_NAME>>
GATEWAY_PG_SCHEMA=<<GATEWAY_PG_SCHEMA>>
RUNTIME_DB_POOL_SIZE=<<GATEWAY_DB_POOL_SIZE>>
RUNTIME_DB_MAX_OVERFLOW=<<GATEWAY_DB_MAX_OVERFLOW>>
RUNTIME_DB_POOL_TIMEOUT=<<GATEWAY_DB_POOL_TIMEOUT>>

# Web 会话历史库（企业版 ChatHistoryStore，pg；WEB_DB_PASSWORD 走 secret configmap）
WEB_DB_TYPE=<<DB_TYPE>>
WEB_DB_HOST=<<DB_HOST>>
WEB_DB_PORT=<<DB_PORT>>
WEB_DB_NAME=<<WEB_DB_NAME>>
WEB_PG_SCHEMA=<<WEB_PG_SCHEMA>>
WEB_DB_USER=<<WEB_DB_USER>>
GATEWAY_WEB_SESSION_STORAGE=<<GATEWAY_WEB_SESSION_STORAGE>>

# Manager HTTP config sync (Manager → Gateway push; Gateway → Manager register/heartbeat)
GATEWAY_CONFIG_RECEIVER_ENABLED=true
GATEWAY_CONFIG_HTTP_HOST=0.0.0.0
GATEWAY_CONFIG_HTTP_PORT=<<GATEWAY_CONFIG_HTTP_PORT>>
GATEWAY_CONFIG_PUBLIC_HOST=<<GATEWAY_NAME>>
GATEWAY_WEB_HTTP_TRUST_CLIENT_HEADERS=true
GATEWAY_MANAGER_HTTP_URL=http://<<MANAGER_SERVER_NAME>>:<<MANAGER_REST_PORT>>
GATEWAY_RUNTIME_MANAGER_URL=http://<<AGENT_RUNTIME_NAME>>:<<AGENT_RUNTIME_PORT>>

# Jiuwen sandbox
JIUWENBOX_ENABLED=<<JIUWENBOX_ENABLED>>
JIUWENBOX_IMAGE=<<JIUWENBOX_IMAGE>>
JIUWENBOX_PORT=8321
JIUWENBOX_CONTAINER_NAME=jiuwenbox
JIUWENBOX_URL=http://127.0.0.1:8321
JIUWENBOX_EXCLUDED_COMMANDS=<<JIUWENBOX_EXCLUDED_COMMANDS>>
JIUWENBOX_SERVER_READINESS_INITIAL_DELAY=5
JIUWENBOX_SERVER_READINESS_PERIOD=10
JIUWENBOX_IDLE_TTL_SECONDS=<<JIUWENBOX_IDLE_TTL_SECONDS>>
JIUWENBOX_IDLE_CHECK_INTERVAL=<<JIUWENBOX_IDLE_CHECK_INTERVAL>>
JIUWENBOX_FALLBACK_ON_FAILURE=<<JIUWENBOX_FALLBACK_ON_FAILURE>>


# Jiuwenbox sidecar options
JIUWENBOX_LISTEN=http://0.0.0.0:8321
JIUWENBOX_POLICY_PATH=<<JIUWENBOX_POD_PKG_PATH>>/configs/enterprise-policy.yaml
JIUWENBOX_MOUNT_CGROUP=true

# K8s Resource Configuration
JIUWENBOX_CPU_REQUEST=<<JIUWENBOX_CPU_REQUEST>>
JIUWENBOX_MEMORY_REQUEST=<<JIUWENBOX_MEMORY_REQUEST>>
JIUWENBOX_CPU_LIMIT=<<JIUWENBOX_CPU_LIMIT>>
JIUWENBOX_MEMORY_LIMIT=<<JIUWENBOX_MEMORY_LIMIT>>

# Gateway多副本模式
DEPLOYMENT_MODE=distributed
GATEWAY_INSTANCE_ID=<<GATEWAY_NAME>>-<<NAMESPACE>>
REDIS_HOST=<<REDIS_HOST>>
REDIS_PORT=<<REDIS_PORT>>
REDIS_MODE=<<REDIS_MODE>>
REDIS_DB=<<REDIS_DB>>
REDIS_KEY_PREFIX=<<REDIS_KEY_PREFIX>>
