# 运行环境模式：支持 dev / product 两种值
# dev 模式：将宿主机代码目录挂载到容器内，支持代码实时修改调试
# product 模式：使用容器内置代码，不挂载宿主机目录，用于生产环境
MODE=product

# 仅在 MODE=dev 时生效：jiuwenclaw 项目在宿主机本地代码路径（请填写绝对路径）
# 不设置时，该模块目录不用挂载
CLAW_CODE_PATH=""

# 仅在 MODE=dev 时生效：agent-runtime 项目在宿主机本地代码路径（请填写绝对路径）
# 不设置时，该模块目录不用挂载
RUNTIME_CODE_PATH=""

# 仅在 MODE=dev 时生效：agent-core 项目在宿主机本地代码路径（请填写绝对路径）
# 不设置时，该模块目录不用挂载
CORE_CODE_PATH=""

# 是否要给 Web 模块mount代码
# 注意Web源代码代码需要npm intall之后，才能mount进容器，此操作只需要一次
IS_MOUNT_WEB_CODE="false"

# 数据库类型，支持 mysql、postgresql，不配默认 mysql
DB_TYPE="mysql"

# 部署工具运行所在K8s节点名称
# 脚本将尝试自动识别节点名，若识别失败，请手动填写值，取值参考 kubectl get nodes 输出第一列节点名称
CURRENT_NODE_NAME=""

# ====================== NFS 服务配置======================
# NFS 模块的镜像地址，用于部署本工具内置的 NFS 服务
NFS_IMAGE=""

# 产品组件的存储挂载模式，可选值：nfs / pvc
# nfs：Pod直接通过地址直连NFS服务挂载共享目录
# pvc：通过K8s PVC持久卷挂载底层存储，由StorageClass动态分配子目录
CLAW_MOUNT_TYPE=""


# ----- NFS直连模式配置（仅 CLAW_MOUNT_TYPE="nfs" 时生效） ----------
# 外部 NFS 服务的服务端地址（IP）
# 留空则自动使用本工具内置部署的 NFS 服务
NFS_SERVER_ADDR=""

# 外部 NFS 服务的共享根目录路径
# 使用本工具内置部署的 NFS 服务时请勿配置该参数，会自动填充内置共享路径
NFS_SHARE_PATH=""

# ------ PVC持久卷模式配置（仅 CLAW_MOUNT_TYPE="pvc" 时生效） --------
# 外部 PV C的名字，该 PVC 需存在，且与业务Pod处于同一Namespace
# 使用本工具内置创建的 PVC 时请勿配置该参数，会自动填充
CLAW_PVC="jiuwenclaw-pvc"

# 外部 PVC 绑定的StorageClass名称
# 使用本工具内置创建的 PVC 时请勿配置该参数，会自动填充
NFS_SC_NAME=""


# ====================== 数据库服务配置（仅支持 postgresql / mysql） ======================
DB_HOST=""  # 外部数据服务的连接地址, 不设置则使用本工具内置部署的数据库服务
DB_PORT=""  # 数据服务的连接端口（本工具内置部署的数据库服务时设置端口，外部数据库服务填写对应端口）

# 当 DB_TYPE 配置为 mysql 时，未设置的时候，默认值为 <module>_<namespace>，以此实现多实例隔离
# 当 DB_TYPE 配置为 postgresql 时，未设置的时候，默认值为 <module>
# 设置时，则优先使用用户配置，覆盖默认规则
GATEWAY_DB_NAME=""            # Gateway网关服务数据库名
IDENTITY_DB_NAME=""           # Identity账号身份服务数据库名
WEB_DB_NAME=""                # 企业Web会话、历史存储数据库名
RUNTIME_DB_NAME=""            # Agent Runtime运行时服务数据库名

# 仅当 DB_TYPE 配置为 postgresql，如下配置才生效
# 未设置时，默认值为<namespace>，以此实现多实例隔离
# 设置时，则优先使用用户配置，覆盖默认规则
GATEWAY_PG_SCHEMA=""          # Gateway网关模块使用的PG schema
IDENTITY_PG_SCHEMA=""         # Identity身份模块使用的PG schema
WEB_PG_SCHEMA=""              # Web会话模块使用的PG schema
RUNTIME_PG_SCHEMA=""          # Agent Runtime运行时模块使用的PG schema

# 支持分库独立账号配置：分别定义 <<MODULE>>_DB_USER / <<MODULE>>_DB_PASSWORD
# 支持全局统一账号配置: 统一定义 DB_USER / DB_PASSWORD
# 优先级规则：若两类变量同时配置，以分库专属账号为准，全局统一账号自动失效
DB_USER=""
DB_PASSWORD=""
GATEWAY_DB_USER=""
GATEWAY_DB_PASSWORD=""
WEB_DB_USER=""
WEB_DB_PASSWORD=""
RUNTIME_DB_USER=""
RUNTIME_DB_PASSWORD=""

# Gateway / AgentServer 访问 MySQL、PostgreSQL 时的 SQLAlchemy 连接池参数
# 会写入 Gateway 环境并通过 Runtime Management 下发给 AgentServer Pod
# 单池峰值连接数 ≈ GATEWAY_DB_POOL_SIZE + GATEWAY_DB_MAX_OVERFLOW
# 空闲时通常只保留 GATEWAY_DB_POOL_SIZE 条连接；超出部分在归还后释放
# 核心池大小（空闲长期保留）
GATEWAY_DB_POOL_SIZE=2
# 高峰临时溢出连接数（用完可释放）
GATEWAY_DB_MAX_OVERFLOW=20
# 从池中获取连接的超时秒数
GATEWAY_DB_POOL_TIMEOUT=30


# ====================== MySQL 服务配置（DB_TYPE="mysql"） ======================
# 本工具内置部署的 MySQL 服务的root用户密码
MYSQL_ROOT_PASSWORD=""

# 本工具内置部署的 MySQL 最大连接数（--max-connections，默认 400；仅自建库生效，外挂库请在库侧配置）
# MySQL 为线程模型，单连接约 1~2Mi，需把大部分内存留给 InnoDB Buffer Pool。
# 按数据库实例可用内存的建议值：
#   2 Gi → 200    4 Gi → 400    8 Gi → 600
#   16 Gi → 1000  32 Gi → 1500  64 Gi → 2000
MYSQL_MAX_CONNECTION=400

# 本工具内置部署的 MySQL 容器最小保证内存：4Gi，K8s 必须分配足够内存才能调度启动；仅自建库生效
# 建议与上方最大连接数档位配套调整（默认不限制，不设置）
MYSQL_MEMORY_REQUEST=4Gi

# 本工具内置部署的 MySQL 容器最大可用内存：4Gi，超出会被 K8s OOM kill；仅自建库生效（默认不限制，不设置）
MYSQL_MEMORY_LIMIT=4Gi

# 本工具内置部署的 MySQL 服务的存储容量（默认4Gi），外挂 MySQL 服务不用填
MYSQL_STORAGE_SIZE="4Gi"

# 本工具内置部署的 MySQL 服务（部署工具创建）对外暴露的访问端口
# 不设置就自动寻找空闲端口，如需要设置，请确保该端口的唯一性（范围: 30000-32767）
MYSQL_NODE_PORT=


# ====================== PostgreSQL 服务配置 （DB_TYPE="postgresql"）======================
# 本工具内置部署的 PostgreSQL 服务的 postgres 用户的密码
POSTGRESQL_PASSWORD=""

# 本工具内置部署的 PostgreSQL 最大连接数（max_connections，默认 192；仅自建库生效，外挂库请在库侧配置）
# PostgreSQL 为进程模型，单连接约 5~10Mi，需把大部分内存留给 shared_buffers。
# 按数据库实例可用内存的建议值：
#   2 Gi → 96     4 Gi → 192    8 Gi → 384
#   16 Gi → 768   32 Gi → 1536  64 Gi → 3072
POSTGRESQL_MAX_CONNECTION=192

# 本工具内置部署的 PostgreSQL 容器最小保证内存：4Gi，K8s 必须分配足够内存才能调度启动；仅自建库生效
# 建议与上方最大连接数档位配套调整（默认不限制，不设置）
POSTGRESQL_MEMORY_REQUEST=4Gi

# 本工具内置部署的 PostgreSQL 容器最大可用内存：4Gi，超出会被 K8s OOM kill；仅自建库生效（默认不限制，不设置）
POSTGRESQL_MEMORY_LIMIT=4Gi

# 本工具内置部署的 PostgreSQL 服务的存储容量（默认4Gi），外挂 PostgreSQL 服务不用填
POSTGRESQL_STORAGE_SIZE="4Gi"

# 本工具内置部署的 PostgreSQL 服务对外暴露的访问端口
# 不设置就自动寻找空闲端口，如需要设置，请确保该端口的唯一性（范围: 30000-32767）
POSTGRESQL_NODE_PORT=

# Gateway 模块 PostgreSQL 专属 Schema 名称，参数为空则默认使用库内置 public Schema
GATEWAY_PG_SCHEMA=""

# Web 模块 PostgreSQL 专属 Schema 名称，参数为空则默认使用库内置 public Schema
WEB_PG_SCHEMA=""

# Agent Runtime 模块 PostgreSQL 专属 Schema 名称，参数为空则默认使用库内置 public Schema
RUNTIME_PG_SCHEMA=""
# 多实例隔离：非 default 命名空间下，未在此显式设置的 PG_SCHEMA 会自动取 <namespace> 做按 schema 隔离。


# ====================== RabbitMQ 服务配置 ======================
# 外部 RabbitMQ 服务的连接地址（格式：host:port）, 不设置则使用部署脚本创建的自建 RabbitMQ
RABBITMQ_URL=""

# RabbitMQ 登录用户名（本工具内置部署 RabbitMQ 服务时设置用户名，外部 RabbitMQ 填写对应用户名）
RABBITMQ_USER=""

# RabbitMQ 登录密码（本工具内置部署 RabbitMQ 服务时设置密码，外部 RabbitMQ 填写对应密码）
RABBITMQ_PASSWORD=""

# 自建 RabbitMQ 存储容量（默认2Gi），外挂 RabbitMQ 服务不用填
RABBITMQ_STORAGE_SIZE="2Gi"

# 本工具内置部署的 RabbitMQ 服务（部署工具创建）对外暴露的访问端口
# 不设置就自动寻找空闲端口，如需要设置，请确保该端口的唯一性（范围: 30000-32767）
RABBITMQ_AMQ_NODE_PORT=
RABBITMQ_MGR_NODE_PORT=


# ====================== Redis 服务配置 ======================
# Redis 部署形态: standalone(单机) | cluster(集群)
REDIS_MODE="standalone"

# 外部 Redis 服务连接地址:
#   standalone(单机/主从): host 或 host:port  (如 10.0.0.11 或 10.0.0.11:6379;不带端口时用 REDIS_PORT)
#   cluster(三主三从):     只配主地址,逗号分隔多个 host:port  (如 10.0.0.11:6379,10.0.0.12:6379,10.0.0.13:6379)
# 不设置则使用部署脚本创建的自建 Redis
REDIS_HOST=""

# 外部 Redis 服务的密码
REDIS_PASSWORD=""

# 外挂 Redis 的连接端口（默认 6379）
# 当 REDIS_HOST 仅填 host(不带 :port)时使用此端口;REDIS_HOST 已带端口或集群节点各自带端口时以其为准
REDIS_PORT="6379"

# 本工具内置部署的 Redis 服务（部署工具创建）对外暴露的访问端口
# 不设置就自动寻找空闲端口，如需要设置，请确保该端口的唯一性（范围: 30000-32767）
REDIS_NODE_PORT=


# ====================== OBS 服务配置 ======================
# 外部对象存储(S3/MinIO兼容)接入地址
# 为空时，自动使用本工具内置部署的MinIO实例
OBS_URL=""

# 业务存储桶名称
# 使用脚本内置部署的 MinIO 时无需配置；对接外部OBS/MinIO服务必须填写
OBS_BUCKET=""

# 对象存储公网预览访问域名
# 仅文件需要浏览器公网直读场景配置，内网环境可不填
OBS_PUBLIC_BASE_URL=""

# 对象存储访问的 AccessKey
# 本工具内置部署的 MinIO：对应 MinIO 的用户账号；外部 OBS：填写云厂商/兼容S3服务的AccessKey
OBS_ACCESS_KEY=""

# 对象存储访问的 SecretKey
# 本工具内置部署的 MinIO：对应 MinIO 的用户密码；外部 OBS：填写云厂商/兼容S3服务的SecretKey
OBS_SECRET_KEY=""

# 客户端连接是否启用HTTPS
# 本工具内置部署的 MinIO：无需配置；外部 OBS：根据服务端SSL开关选择 true/false
OBS_SECURE="false"

# 对象存储区域标识
# 本工具内置部署的 MinIO：无需配置；外部 OBS：按需填写
OBS_REGION=""

# ====================== Log 服务配置 ======================
# Vector 容器镜像地址
VECTOR_IMAGE=""

# Fluent Bit 容器镜像地址
FLUENT_BIT_IMAGE=""

# 宿主机日志存储根目录。默认是$HOME/claw_logs，建议手动显式配置，保证日志路径固定有读写权限
CLAW_LOG_DIR=""

# 日志采集端(Vector)日志脱敏开关
COLLECT_LOG_MASK_ENABLED=false


# ====================== Gateway 服务配置 ======================
# Gateway 服务镜像地址
GATEWAY_IMAGE=""

# Gateway 与 AgentServer 建立WebSocket长连接心跳配置（单位：秒）
GATEWAY_CLAW_WS_PING_INTERVAL="20.0"    # WebSocket 心跳发送间隔
GATEWAY_CLAW_WS_PING_TIMEOUT="20.0"     # WebSocket 心跳无响应超时阈值，超过该时间未收到对端pong则断开重连

# 请求级扩展字段白名单，逗号分隔；空值表示关闭。
# HTTP 从同名请求头读取，WebSocket 从握手 query 读取；仅白名单字段会透传至 Rail。
JIUWENSWARM_REQUEST_EXT_FORWARD_HEADERS=""

# SessionMap 会话映射策略
# 仅适用于企业版 Claw 场景（如 feishu_enterprise 等企业通道）
# 作用：将平台用户身份映射为 Agent 内部会话唯一标识（session_id）
# 可选值：
#   per_chat_bot        - 默认值，同一聊天窗口+机器人共享会话
#   per_chat_bot_user   - 按用户维度隔离会话（每个用户独立会话）
GATEWAY_SESSION_MAP_SCOPE="per_chat_bot_user"

# Gateway 服务的容器最小保证 CPU：0.5核（500毫核），K8s 必须分配足够CPU才能调度启动
GATEWAY_CPU_REQUEST=500m

# Gateway 服务的容器最小保证 内存：1Gi，K8s 必须分配足够内存才能调度启动
GATEWAY_MEMORY_REQUEST=1Gi

# Gateway 服务的容器最大可用 CPU：0.5核，超出会被K8s限流
GATEWAY_CPU_LIMIT=500m

# Gateway 服务的容器最大可用 内存：1Gi，超出会被K8s强制杀死重启
GATEWAY_MEMORY_LIMIT=1Gi

# 业务应用内置日志脱敏功能开关
LOG_MASK_ENABLED=true

# 业务应用日志本地文件输出开关
# true：业务进程同时输出至标准输出 + 写入本地日志文件（容器内）
# false：业务进程仅输出日志至标准输出，想要持久化，可通过 FluentBit+Vector 采集后统一落盘到宿主机上
LOG_TO_FILE_ENABLED=true

# Gateway Pod 调度限制开关，开启后仅能调度到带有 gateway=enable 标签的节点
GATEWAY_SCHED_LABEL_ENABLED="false"

# Gateway 副本实例数量，控制部署运行的 Pod 个数
GATEWAY_REPLICAS=1

# ====================== AgentServer 配置 ======================
# AgentServer 服务镜像地址
AGENT_SERVER_IMAGE=""

#拓展配置自定义rail
AGENT_EXTRA_RAILS=""

#拓展配置自定义tool（模块需暴露 register_tools() 工厂，分号分隔多个模块路径）
AGENT_EXTRA_TOOLS=""

# PIP 安装扩展依赖时的额外参数
# 示例配置阿里云PyPI镜像源，优化内网/国内环境包下载速度，可根据实际环境自定义调整
PIP_EXTRA_ARGS="-i https://mirrors.aliyun.com/pypi/simple"

# AgentServer 服务的容器最小保证 CPU：500毫核（0.5核），K8s 必须至少分配这么多 CPU 才能启动
AGENT_SERVER_CPU_REQUEST=500m

# AgentServer 服务的容器最小保证 内存：1Gi，K8s 必须至少分配这么多内存才能启动
AGENT_SERVER_MEMORY_REQUEST=1Gi

# AgentServer 服务的容器最大可用 CPU：500毫核（0.5核），超过会被 K8s 限流
AGENT_SERVER_CPU_LIMIT=500m

# AgentServer 服务的容器最大可用 内存：1Gi，超过会被 K8s OOM kill 杀死重启
AGENT_SERVER_MEMORY_LIMIT=1Gi

# AgentServer 服务的容器里自定义的环境变量，JSON字符串格式, 如下是个例子，请按需设置, 数量不限
# 格式规范：key为环境变量名，value为对应变量值
AGENT_SERVER_CUSTOM_ENVS="{"key1":"value1", "key2":"value2"}"

# 单个 agentserver Pod 的总并发容量
AGENT_SERVER_SERVICE_CONCURRENCY=10

# 单个 session 内最多多少条消息并行处理
AGENT_SERVER_SESSION_CONCURRENCY=10

# Session 与 AgentServer Pod 的亲和性绑定 TTL（秒），请求完成后保留映射 TTL 秒，期内续期、到期移除；
# 设短易丢亲和性（重新初始化 Agent），设长占资源。
AGENT_SERVER_SESSION_TTL=60

# Gateway 默认路由时对 bot_id 的分桶数量；0 表示不分桶（使用原始 bot_id）
AGENT_BOT_ID_GROUP_NUM=0

# ReActAgent 的最大循环轮数上限,  即 agent "思考→调工具→再思考"这个循环最多跑多少轮。它是防止 agent 无限循环的"刹车"——达到上限后强制停止，不管任务有没有完成。否则极端情况下，LLM 一直不收敛（不停调工具），那花费的时间会非常恐怖。
AGENT_SERVER_REACT_MAX_ITER=10

# 调用fetch_webpage工具时，单次 HTTP 请求超时
FETCH_WEBPAGE_TIMEOUT=5

# 调用fetch_webpage工具时，整个并发 fetch 总超时
FETCH_WEBPAGE_TOTAL_TIMEOUT=10

# ======================  JIUWENBOX 配置 ======================
# JIUWENBOX 服务镜像地址
JIUWENBOX_IMAGE=""

# JIUWENBOX 服务的容器最小保证 CPU：500毫核（0.5核），K8s 必须至少分配这么多 CPU 才能启动
JIUWENBOX_CPU_REQUEST=500m

# JIUWENBOX 服务的容器最小保证 内存：1Gi，K8s 必须至少分配这么多内存才能启动
JIUWENBOX_MEMORY_REQUEST=1Gi

# JIUWENBOX 服务的容器最大可用 CPU：500毫核（0.5核），超过会被 K8s 限流
JIUWENBOX_CPU_LIMIT=500m

# JIUWENBOX 服务的容器最大可用 内存：1Gi，超过会被 K8s OOM kill 杀死重启
JIUWENBOX_MEMORY_LIMIT=1Gi


# ====================== WEB 服务配置 ======================
# Web 前端模块容器镜像地址
WEB_IMAGE=""

# WebSocket 跨域 Origin 校验总开关
# true：开启 Origin 来源校验，仅白名单内域名允许建立 WS 握手连接
# false：关闭 Origin 校验，放行所有来源（开发/内网调试场景使用，生产环境不推荐）
WS_ORIGIN_CHECK_ENABLED="false"

# WebSocket 握手 Origin 白名单配置（仅 WS_ORIGIN_CHECK_ENABLED=true 时生效）
# 规则说明：
# 1. 多个域名使用英文逗号分隔，采用完整域名精确匹配，不支持通配符模糊匹配
# 2. 默认内置放行 localhost、127.0.0.1，无需手动填入此配置
# 3. 示例：WS_ALLOWED_ORIGINS="example.com,admin.example.com,192.168.1.100"
WS_ALLOWED_ORIGINS=""

# Web 服务对外暴露的主机端口
# 不设置就自动寻找空闲端口，如需要设置，请确保该端口的唯一性（范围: 30000-32767）
WEB_NODE_PORT=

# 企业级 Web：聊天界面工具结果展示的最大字符数（经 Gateway 注入；0 表示不截断，默认 500）
TOOL_RESULT_DISPLAY_MAX_CHARS=500

# WEB 服务的容器最小保证 CPU：500毫核（0.5核），K8s 必须至少分配这么多 CPU 才能启动
WEB_CPU_REQUEST=500m

# WEB 服务的容器最小保证 内存：1Gi，K8s 必须至少分配这么多内存才能启动
WEB_MEMORY_REQUEST=1Gi

# WEB 服务的容器最大可用 CPU：500毫核（0.5核），超过会被 K8s 限流
WEB_CPU_LIMIT=500m

# WEB 服务的容器最大可用 内存：1Gi，超过会被 K8s OOM kill 杀死重启
WEB_MEMORY_LIMIT=1Gi

# ====================== Agent Runtime 服务配置 ======================
# Agent Runtime 服务镜像地址
AGENT_RUNTIME_IMAGE=""

# Agent Runtime 副本实例数量，控制部署运行的 Pod 个数
AGENT_RUNTIME_REPLICAS=1

# ====================== 大模型接口配置 ======================
# 模型厂商标识（如：OpenAI等）
