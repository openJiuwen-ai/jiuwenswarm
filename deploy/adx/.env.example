# ====================== 集群主机配置 ======================
# 目标主机IP列表，逗号分隔。第一个IP为yr master节点，其余为agent节点
# 单机部署示例：CLUSTER_HOSTS="192.168.1.1"
# 多机部署示例：CLUSTER_HOSTS="192.168.1.1,192.168.1.2,192.168.1.3"
# 也可通过命令行 --hosts 参数指定，命令行参数优先级更高
# 不设置时默认使用本机IP
CLUSTER_HOSTS=""

# Python版本（用于远程安装 ADX 依赖）
PYTHON_VERSION="3.11"

# jiuwenswarm 安装包 URL（远程主机未安装 jiuwenswarm 时使用此URL进行pip安装）
# 示例：JIUWENSWARM_PACKAGE_URL="https://example.com/jiuwenswarm-0.1.0-py3-none-any.whl"
# 如果远程主机已安装 jiuwenswarm，此配置不需要设置
JIUWENSWARM_PACKAGE_URL=""

# ====================== Gateway配置 ======================
# jiuwenswarm 实例名（留空则使用默认 workspace ~/.jiuwenswarm）
# 指定实例名后：
#   AS      -> ~/.jiuwenswarm-instances/<实例名>/config/config.yaml
#   Gateway -> ~/.jiuwenswarm-instances/<实例名>/config/config-gateway.yaml
JIUWENSWARM_INSTANCE_NAME=""

# Gateway 配置目录覆盖。留空时使用 <workspace>/config。
# 绝对路径直接使用；相对路径按 <workspace>/config/<override> 解析。
# 该变量只影响 Gateway，由 systemd/nohup 注入，不写入共享 .env。
JIUWENSWARM_GATEWAY_CONFIG_DIR=""

# SessionMap 会话映射策略
# 可选值：per_chat_bot（同聊天窗口+机器人共享会话）、per_chat_bot_user（按用户维度隔离会话）
GATEWAY_SESSION_MAP_SCOPE="per_chat_bot_user"

# 扩展包搜索目录（远程主机上的路径，多个目录用分号;分隔）
# 留空则自动从 jiuwenswarm 安装路径推断：<pip_location>/jiuwenswarm/extensions
# 如需自定义，可设置完整路径，多个目录用分号分隔
# 示例：EXTENSION_DIRS="/opt/pip_location/jiuwenswarm/extensions;/opt/my_extensions"
EXTENSION_DIRS=""

# ====================== Gateway独立部署配置 ======================
# 以下配置仅在单独部署 gateway 时需要手动设置
# 如果先部署 ADX 再部署 gateway，这些值会自动获取，无需手动设置

# Master节点IP（单独部署 gateway 时需要指定）
MASTER_NODE_IP=""


# Agent OS 注册中心端口（单独部署 gateway 时可指定，默认4003）
REGISTRY_PORT=""

# SSH channel 监听端口（单独部署 gateway 时可指定，默认2223）
# 监听 IP 使用 MASTER_NODE_IP
SSH_PORT=""

# TUI GatewayServer 监听地址（/tui）
# HOST 不设置时部署脚本会自动填成 0.0.0.0（对外可访问）
GATEWAY_HOST=""
# TUI 监听端口；空则 check_handler 填默认 19001
GATEWAY_PORT=""

# WebChannel 监听地址（/ws）
# HOST 不设置时部署脚本会自动填成 0.0.0.0（对外可访问）
WEB_HOST=""
# WebChannel 监听端口；空则 check_handler 填默认 19000
WEB_PORT=""

# ====================== Web 静态服务器配置 ======================
# jiuwenswarm-web：serve jiuwenswarm/channels/web/frontend/dist 静态文件，
# /ws 代理到上面的 WEB_PORT（gateway 的 WebChannel），/api 代理到后端。
# 浏览器访问 http://<host>:<WEB_STATIC_PORT>/ 即 jiuwenswarm 的 web 端。
# 注意：通过独立的静态服务参数配置监听地址和端口，
# 通过 --host/--port 显式传给 jiuwenswarm-web，不依赖 app_web.py 的 FRONTEND_HOST/PORT 默认值。

# Web 静态服务器监听地址；空则 check_handler 填默认 0.0.0.0（对外可访问）
WEB_STATIC_HOST=""
# Web 静态服务器监听端口；空则 check_handler 填默认 5173
WEB_STATIC_PORT=""

# AgentOS 空闲沙箱回收超时（秒）；覆盖 gateway.agentos.sandbox_idle_timeout_seconds
# 默认 600；<=0 禁用回收。未设置时使用 yaml 配置。
SANDBOX_IDLE_TIMEOUT_SECONDS=""

# GET /api/agent 等到 running 的超时（秒）；覆盖 gateway.agentos.wait_running_timeout_seconds
# 默认 90。须覆盖 startup 探针预算（initial_delay + period * failure_threshold；
# builtin 21 / 3rdagent 26）。小于该下限时 Gateway 告警并抬高，避免 create 成功后仍超时。
AGENTOS_WAIT_RUNNING_TIMEOUT_SECONDS=""
# GET 轮询间隔（秒）；覆盖 gateway.agentos.wait_running_interval_seconds。默认 1。
AGENTOS_WAIT_RUNNING_INTERVAL_SECONDS=""
# ADX TCP 探针时序（秒 / 次数）；覆盖 gateway.agentos.probes.*
AGENTOS_PROBE_STARTUP_INITIAL_DELAY_SECONDS=""
AGENTOS_PROBE_STARTUP_PERIOD_SECONDS=""
AGENTOS_PROBE_STARTUP_TIMEOUT_SECONDS=""
AGENTOS_PROBE_STARTUP_FAILURE_THRESHOLD=""
AGENTOS_PROBE_LIVENESS_TIMEOUT_SECONDS=""
AGENTOS_PROBE_LIVENESS_FAILURE_THRESHOLD=""

# Channel 连接断开清理超时（秒）；覆盖 gateway.agentos.disconnect_cleanup_timeout_seconds
# 连接数归零后，等待该时长再删除 jiuwenswarm agent（期间可重连、in-flight chat/SSH 可完成）
# 默认 60；<=0 禁用清理。未设置时使用 yaml 配置。
DISCONNECT_CLEANUP_TIMEOUT_SECONDS=""

# Cron 作业定义持久化（写入 gateway-config.yaml 的 <<CRON_STORE_BACKEND>> / <<ETCD_ENDPOINTS>>）
# file（单节点，默认）| etcd（一体机主备）。etcd 时填写可达地址，例如 http://127.0.0.1:2379
# AgentOS 一体机模板默认 etcd。显式 CRON_STORE_BACKEND=file 可改回本地文件。
# ETCD_ENDPOINTS 留空时，check_handler 从 ~/.agentos/deploy/config.yaml 的 etcd_nodes
# 自动拼 http://<ip>:<ETCD_CLIENT_PORT>，端口默认 32379。
CRON_STORE_BACKEND="etcd"
ETCD_ENDPOINTS=""

# AgentOS 可选 Code Graph；off（默认）| graph，需部署支持 Code Graph 的 SDK。
AGENTOS_CODE_GRAPH_PROFILE="off"
# jiuwenbox（默认 bubblewrap）| jiuwenbox-conch；Conch 必须填写模板名。
TOOL_SANDBOX_TYPE="jiuwenbox"
TOOL_SANDBOX_ENABLE="true"
TOOL_SANDBOX_EXECUTOR="bubblewrap"
TOOL_SANDBOX_IMAGE=""
# ADX 沙箱静态资源限制（写入 gateway-config.yaml 的 sandbox.cpu/memory）。
# CPU 单位毫核（1000 = 1 核），内存单位 MB；留空不写入。
# etcd 数据面 /agentos/config/data-plane 的 sandbox.cpu/memory 可在运行期覆盖。
TOOL_SANDBOX_CPU=""
TOOL_SANDBOX_MEMORY=""
# ADX docker 容器运行身份（写入 gateway-config.yaml 的 sandbox.user/group）。
# 数字 uid/gid 或宿主机用户名/组名均可；两者必须同时设置，留空以镜像默认身份运行。
TOOL_SANDBOX_USER=""
TOOL_SANDBOX_GROUP=""
CONCH_TEMPLATE_NAME=""
# SDK 配置必须已存在于内置 Agent 运行镜像内，不是 Gateway 宿主机路径。
CONCH_SDK_CONFIG=""

# AgentOS IAM 鉴权（写入 gateway-config.yaml 的 <<AGENTOS_AUTH_*>>）
# gateway.agentos.auth_enabled=true 时生效
# URL 不设置时部署脚本会填成 http://MASTER_NODE_IP:8090；外置/K8s 可写完整 URL 覆盖
AGENTOS_AUTH_SERVICE_URL=""
# 超时秒数；空则 check_handler 填默认 10
AGENTOS_AUTH_TIMEOUT=""


# ====================== 大模型接口配置 ======================
# 模型厂商标识（如：OpenAI等）
MODEL_PROVIDER=""

# 大模型名称
MODEL_NAME=""

# 大模型API基础地址
API_BASE=""

# 大模型鉴权密钥
API_KEY=""

# ====================== 向量模型接口配置 ======================
# 向量模型名称
EMBED_MODEL=""

# 向量模型API基础地址
EMBED_API_BASE=""

# 向量模型鉴权密钥
EMBED_API_KEY=""

# Gateway ADX HTTP connection; ADX is deployed separately.
ADX_INGRESS_URL="https://192.0.2.10:8443"
ADX_TENANT="agentos"
ADX_TOKEN=""
ADX_AGENTSERVER_IMAGE="agentos-supervisor:v1"
ADX_AGENTSERVER_RUNTIME="supervisor"
