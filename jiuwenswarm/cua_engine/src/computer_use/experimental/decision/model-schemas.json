{
  "delegation": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "instruction": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000,
        "description": "One clear subtask, with the user's relevant constraints and intended result. Describe what to accomplish; the executor handles observations and individual actions."
      },
      "app": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "Exact application/window id from the supplied desktop catalogue. Copy the id, not the display name. For navigation, select a suitable listed starting window and preserve its document. Do not bypass multiple listed windows using their shared application name or bundle id."
      },
      "steps": {
        "description": "Ordered UI stages. Prefer {instruction,actions} when inputs are known; host advances after dispatch and observes once. Use a string/observation stage for a result that must be interpreted. Shared constraints belong in instruction. End with result verification; dispatch alone is not success.",
        "minItems": 1,
        "maxItems": 12,
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000,
              "description": "One clear subtask, with the user's relevant constraints and intended result. Describe what to accomplish; the executor handles observations and individual actions."
            },
            {
              "type": "object",
              "properties": {
                "instruction": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000,
                  "description": "One clear subtask, with the user's relevant constraints and intended result. Describe what to accomplish; the executor handles observations and individual actions."
                },
                "actions": {
                  "description": "Fixed ordered inputs. The worker resolves and dispatches only the next ready prefix, observing new UI before the remaining inputs. It cannot change operations/data, skip or reorder. Omit/empty means a free observation or dynamic stage. typeText replace:true replaces the whole input; false/omitted inserts.",
                  "maxItems": 12,
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "op": {
                            "type": "string",
                            "const": "click"
                          },
                          "target": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096,
                            "description": "Describe the intended current UI target and its context; the worker resolves it from observations. Never predict a numeric ref."
                          },
                          "button": {
                            "type": "string",
                            "enum": [
                              "left",
                              "right",
                              "middle"
                            ]
                          },
                          "count": {
                            "anyOf": [
                              {
                                "type": "number",
                                "const": 1
                              },
                              {
                                "type": "number",
                                "const": 2
                              }
                            ]
                          }
                        },
                        "required": [
                          "op",
                          "target"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "op": {
                            "type": "string",
                            "const": "typeText"
                          },
                          "target": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096,
                            "description": "Describe the intended current UI target and its context; the worker resolves it from observations. Never predict a numeric ref."
                          },
                          "text": {
                            "type": "string",
                            "maxLength": 65536
                          },
                          "replace": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "op",
                          "target",
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "op": {
                            "type": "string",
                            "const": "paste"
                          },
                          "target": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096,
                            "description": "Describe the intended current UI target and its context; the worker resolves it from observations. Never predict a numeric ref."
                          },
                          "text": {
                            "type": "string",
                            "maxLength": 65536
                          }
                        },
                        "required": [
                          "op",
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "op": {
                            "type": "string",
                            "const": "pressKey"
                          },
                          "target": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096,
                            "description": "Describe the intended current UI target and its context; the worker resolves it from observations. Never predict a numeric ref."
                          },
                          "key": {
                            "type": "string",
                            "maxLength": 65536
                          }
                        },
                        "required": [
                          "op",
                          "key"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "op": {
                            "type": "string",
                            "const": "openMenu"
                          },
                          "target": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096,
                            "description": "Describe the intended current UI target and its context; the worker resolves it from observations. Never predict a numeric ref."
                          }
                        },
                        "required": [
                          "op",
                          "target"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "op": {
                            "type": "string",
                            "const": "scroll"
                          },
                          "target": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096,
                            "description": "Describe the intended current UI target and its context; the worker resolves it from observations. Never predict a numeric ref."
                          },
                          "direction": {
                            "type": "string",
                            "enum": [
                              "up",
                              "down",
                              "left",
                              "right"
                            ]
                          },
                          "pages": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 20
                          }
                        },
                        "required": [
                          "op",
                          "target",
                          "direction"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "op": {
                            "type": "string",
                            "const": "drag"
                          },
                          "target": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096,
                            "description": "Describe the intended current UI target and its context; the worker resolves it from observations. Never predict a numeric ref."
                          }
                        },
                        "required": [
                          "op",
                          "target"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "instruction"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "required": [
      "instruction",
      "app"
    ],
    "additionalProperties": false
  },
  "commands": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "command": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "actions": {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "click"
                        },
                        "ref": {
                          "type": "string",
                          "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
                        },
                        "x": {
                          "type": "number",
                          "minimum": 0
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0
                        },
                        "button": {
                          "type": "string",
                          "enum": [
                            "left",
                            "right",
                            "middle"
                          ]
                        },
                        "count": {
                          "anyOf": [
                            {
                              "type": "number",
                              "const": 1
                            },
                            {
                              "type": "number",
                              "const": 2
                            }
                          ]
                        }
                      },
                      "required": [
                        "op"
                      ],
                      "additionalProperties": false,
                      "allOf": [
                        {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "ref": {
                                  "type": "string",
                                  "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
                                },
                                "x": {
                                  "not": {}
                                },
                                "y": {
                                  "not": {}
                                }
                              },
                              "required": [
                                "ref"
                              ]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "ref": {
                                  "not": {}
                                },
                                "x": {
                                  "type": "number",
                                  "minimum": 0
                                },
                                "y": {
                                  "type": "number",
                                  "minimum": 0
                                }
                              },
                              "required": [
                                "x",
                                "y"
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "typeText"
                        },
                        "ref": {
                          "type": "string",
                          "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 65536
                        },
                        "replace": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "op",
                        "ref",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "paste"
                        },
                        "ref": {
                          "type": "string",
                          "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 65536
                        }
                      },
                      "required": [
                        "op",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "pressKey"
                        },
                        "ref": {
                          "type": "string",
                          "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
                        },
                        "key": {
                          "type": "string",
                          "maxLength": 65536
                        }
                      },
                      "required": [
                        "op",
                        "key"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "openMenu"
                        },
                        "ref": {
                          "type": "string",
                          "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
                        }
                      },
                      "required": [
                        "op",
                        "ref"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "scroll"
                        },
                        "ref": {
                          "type": "string",
                          "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
                        },
                        "x": {
                          "type": "number",
                          "minimum": 0
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0
                        },
                        "direction": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down",
                            "left",
                            "right"
                          ]
                        },
                        "pages": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 20
                        }
                      },
                      "required": [
                        "op",
                        "direction"
                      ],
                      "additionalProperties": false,
                      "allOf": [
                        {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "ref": {
                                  "type": "string",
                                  "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
                                },
                                "x": {
                                  "not": {}
                                },
                                "y": {
                                  "not": {}
                                }
                              },
                              "required": [
                                "ref"
                              ]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "ref": {
                                  "not": {}
                                },
                                "x": {
                                  "type": "number",
                                  "minimum": 0
                                },
                                "y": {
                                  "type": "number",
                                  "minimum": 0
                                }
                              },
                              "required": [
                                "x",
                                "y"
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "drag"
                        },
                        "fromX": {
                          "type": "number",
                          "minimum": 0
                        },
                        "fromY": {
                          "type": "number",
                          "minimum": 0
                        },
                        "toX": {
                          "type": "number",
                          "minimum": 0
                        },
                        "toY": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "op",
                        "fromX",
                        "fromY",
                        "toX",
                        "toY"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "image": {
                "type": "boolean"
              },
              "window": {
                "description": "Explicitly target this separately observed window for the entire batch. Omit for the current working view. All refs must belong to the selected observation; a catalogue entry alone is insufficient.",
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
              }
            },
            "required": [
              "actions"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "read"
              },
              "window": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "ref": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "menuPath": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "image": {
                "type": "boolean"
              }
            },
            "required": [
              "op"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
                      },
                      "offset": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "window": {
                        "type": "string",
                        "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
                      },
                      "menuPath": {
                        "not": {}
                      }
                    },
                    "required": [
                      "ref"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "not": {}
                      },
                      "offset": {
                        "not": {}
                      },
                      "window": {
                        "type": "string",
                        "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
                      },
                      "menuPath": {
                        "minItems": 1,
                        "maxItems": 8,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "done"
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "description": "Evidence that the current stage's result is established. Unmet or uncertain requirements require further work or handoff, never done."
              }
            },
            "required": [
              "op",
              "summary"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "handoff"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "required": [
      "command"
    ],
    "additionalProperties": false
  }
}
