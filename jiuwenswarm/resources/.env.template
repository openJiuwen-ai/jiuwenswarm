API_BASE="https://example.com/compatible-mode/v1"
API_KEY="sk-xxxxxxxxx"
MODEL_NAME="your-model-name"
# or other provider like SiliconFlow, etc.
# MODEL_PROVIDER 现为协议名：OpenAI（兼容协议）或 Anthropic。
# 原供应商名（DeepSeek/SiliconFlow/DashScope/OpenRouter 等）改由 endpoint_profile 表达。
MODEL_PROVIDER=OpenAI
# endpoint_profile：仅 OpenAI 协议生效的端点方言。
#   openai(官方/默认) / deepseek / openrouter / siliconflow / dashscope /
#   openai_compatible(KV释放/亲和) / ollama / lmstudio / vllm / sglang。
#   MODEL_PROVIDER=Anthropic 时此变量被忽略。
ENDPOINT_PROFILE=openai
CUSTOM_HEADERS=

EMBED_API_BASE=
EMBED_API_KEY=
EMBED_MODEL=

# Video vision / understanding model configuration.
VIDEO_API_BASE=
VIDEO_API_KEY=
VIDEO_MODEL_NAME="your-video-model-name"
VIDEO_PROVIDER=
# 端点方言；走 DashScope 多模态口填 dashscope，否则 openai_compatible。
VIDEO_ENDPOINT_PROFILE=openai_compatible

# Audio processing model selection.
AUDIO_API_BASE=
AUDIO_API_KEY=
AUDIO_MODEL_NAME="your-audio-model-name"
AUDIO_PROVIDER=
# 端点方言；走 DashScope 多模态口填 dashscope，否则 openai_compatible。
AUDIO_ENDPOINT_PROFILE=openai_compatible

# Vision/Image processing model selection.
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL_NAME="your-vision-model-name"
VISION_PROVIDER=
# 端点方言；走 DashScope 多模态口填 dashscope，否则 openai_compatible。
VISION_ENDPOINT_PROFILE=openai_compatible

# Image generation (DashScope wanx by default).
IMAGE_GEN_API_BASE=https://dashscope.aliyuncs.com/api/v1
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL_NAME=wanx-v1
IMAGE_GEN_PROVIDER=DashScope

# Video generation (DashScope wan by default). When empty, falls back to IMAGE_GEN_* credentials.
VIDEO_GEN_API_BASE=
VIDEO_GEN_API_KEY=
VIDEO_GEN_MODEL_NAME=wan2.6-t2v
VIDEO_GEN_PROVIDER=DashScope

GITHUB_TOKEN=

# Paid Search Providers (mcp_paid_search tool)
# Empty API_KEY disables the corresponding provider.
# When provider=auto, services are attempted in order:
# bocha → perplexity → serper → jina
BOCHA_API_KEY=
PERPLEXITY_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=

# Custom API endpoints for each provider. Leave blank to use official default URLs.
# Fill in this field for private deployment, proxy forwarding or custom mirror addresses
BOCHA_API_URL=
PPLX_API_URL=
SERPER_API_URL=
JINA_API_URL=

# RITS (Tool Evaluation & LLM Call Generation for Agent Self-Evolution Optimizer)
RITS_API_URL=

FREE_SEARCH_PROXY_URL=
# Disable SSL certificate verification for jiuwenswarm HTTP tools.
# Useful behind corporate TLS interception proxies or self-signed certificates.
# Default: true
# JIUWENSWARM_SSL_VERIFY=false
# Set to false behind corporate TLS interception proxies if free search fails
# with SSLCertVerificationError/self-signed certificate errors.
FREE_SEARCH_SSL_VERIFY=false
# DuckDuckGo HTML endpoint. html.duckduckgo.com is usually less likely to return
# anti-bot pages than duckduckgo.com/html behind corporate proxies.
FREE_SEARCH_DDG_URL=https://html.duckduckgo.com/html/

# Browser MCP runtime (optional)
# 0: disabled, 1: enabled
BROWSER_RUNTIME_MCP_ENABLED=1
# supported here: stdio|sse|streamable-http
# recommended: streamable-http
BROWSER_RUNTIME_MCP_CLIENT_TYPE=streamable-http
BROWSER_RUNTIME_MCP_SERVER_ID=playwright_runtime_wrapper
BROWSER_RUNTIME_MCP_SERVER_NAME=playwright-runtime-wrapper
# when client_type=streamable-http, default endpoint is http://127.0.0.1:8940/mcp
# when client_type=sse, default endpoint is http://127.0.0.1:8940/sse
# when client_type=stdio, this path can keep stdio://... as metadata only
BROWSER_RUNTIME_MCP_SERVER_PATH=http://127.0.0.1:8940/mcp
BROWSER_RUNTIME_MCP_TIMEOUT_S=300
# optional local wrapper host/port/path for auto-start
BROWSER_RUNTIME_MCP_HOST=127.0.0.1
BROWSER_RUNTIME_MCP_PORT=8940
BROWSER_RUNTIME_MCP_PATH=/mcp
# stdio mode command override (empty means use current python executable)
BROWSER_RUNTIME_MCP_COMMAND=
# optional args override; leave empty to use built-in default:
# <repo>/jiuwenswarm/agentserver/tools/browser-move/src/playwright_runtime_mcp_server.py --transport stdio --no-banner
BROWSER_RUNTIME_MCP_ARGS=
# stdio mode will prefer sse fallback first when enabled (recommended 1)
BROWSER_RUNTIME_MCP_AUTO_SSE_FALLBACK=1

# runtime wrapper internals
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_ARGS=-y @playwright/mcp@latest
PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222
PLAYWRIGHT_TOOL_TIMEOUT_S=300
BROWSER_TIMEOUT_S=600
# default behavior: browser_run_task will not honor model-provided timeout_s values below
# BROWSER_TIMEOUT_S. Set this only if you explicitly want short per-call overrides.
BROWSER_ALLOW_SHORT_TIMEOUT_OVERRIDE=0

######## BROWSER MOVE MODE ########
# managed browser
BROWSER_DRIVER=managed
BROWSER_PROFILE_NAME=Default

# # remote browser 
# BROWSER_DRIVER=remote
# PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222

# # playwright extension browser 
# BROWSER_DRIVER=extension
# PLAYWRIGHT_MCP_EXTENSION_TOKEN=

EMAIL_ADDRESS=""
EMAIL_TOKEN=""

EVOLUTION_AUTO_SCAN="false"

# SkillNet timeout configuration
SKILLNET_DOWNLOAD_TIMEOUT=60
SKILLNET_MAX_RETRIES=3

# Team Skills Hub（空则默认 https://teamskills.openjiuwen.com）
TEAM_SKILLS_HUB_BASE_URL=
# Team Skills Hub 用户鉴权 Token（与 SYSTEM_TOKEN 二选一；publish/delete/recommend 需要）
TEAM_SKILLS_HUB_USER_TOKEN=
# Team Skills Hub 系统鉴权 Token（与 USER_TOKEN 二选一；skills.swarmskillshub.recommend 优先用此项代调 POST /api/v1/recommend）
TEAM_SKILLS_HUB_SYSTEM_TOKEN=
# 请求超时（秒）
TEAM_SKILLS_HUB_TIMEOUT=60
# ZIP 下载主机白名单（逗号分隔）；空则使用内置默认（含 127.0.0.1 / localhost）
TEAM_SKILLS_HUB_ALLOWED_DOWNLOAD_HOSTS=

NO_PROXY=localhost,127.0.0.1,api.openai.rnd.huawei.com

# Memory mode (default is "local" when empty)
MEMORY_MODE=

# Extension package search dirs, separated by ';'
EXTENSION_DIRS=""

# WebSocket Origin validation.
# Set JIUWENSWARM_ENABLE_ORIGIN_CHECK=1 to enable checks.
# Use English commas only; add "none" to allow connections without an Origin header.
JIUWENSWARM_ENABLE_ORIGIN_CHECK=0
JIUWENSWARM_WS_ALLOWED_ORIGIN_HOSTS=127.0.0.1,localhost

# For GitCode Operations
# Create one at https://gitcode.com/setting/token-classic
GITCODE_ACCESS_TOKEN=

# Team task card title/content truncation limit (chars) sent to the Web panel.
# Over-limit title/content is truncated with an inline "…(truncated, total N chars)"
# marker. Must be a positive integer; blank/invalid/non-positive falls back to 4096.
# JIUWENSWARM_TASK_TEXT_LIMIT=4096
