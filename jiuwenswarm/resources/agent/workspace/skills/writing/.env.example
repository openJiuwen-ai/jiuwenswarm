# .env.example — writing 模块环境变量模板
# 复制为 .env 并填入真实凭证；main.py 会通过 jiuwenswarm/resources/.env 自动加载。

# LLM Provider（默认 anthropic；可选 openai）
LLM_PROVIDER=anthropic

# LLM 模型名（默认 claude-sonnet-5；可换 openai/gpt-4o 等）
LLM_MODEL=claude-sonnet-5

# LLM 最大 token 输出（默认 8000）
LLM_MAX_TOKENS=8000

# LLM 温度（默认 0.4）
LLM_TEMPERATURE=0.4

# Anthropic API Key（使用 anthropic provider 时必填）
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key（使用 openai provider 时必填）
OPENAI_API_KEY=sk-...
