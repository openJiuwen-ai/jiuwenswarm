{
  "$schema": "../workswarm-theme/schema/theme.schema.json",
  "theme_api": 1,
  "id": "workswarm-theme-hive",
  "name": "蜂巢协同",
  "version": "1.0.4",
  "description": "openJiuwen 专属 3D 主题：绒毛小蜜蜂在黑金蜂巢前勾出六边形网络，蜂群涌出、连线、列阵后进入工作台；晨光蜂巢动态背景，附开场音乐。",
  "tags": ["3D", "openJiuwen", "开场动画", "动态背景", "开场音乐"],
  "preview": "preview.jpg",
  "appearance": {
    "accent": "#b45309",
    "surface_opacity": 0.8,
    "tokens": {
      "--color-scrollbar-thumb": "rgba(180, 83, 9, .3)",
      "--color-sidebar-nav-active": "rgba(214, 140, 30, .14)",
      "--color-sidebar-nav-active-hover": "rgba(214, 140, 30, .2)",
      "--color-conversation-active-surface": "rgba(214, 140, 30, .14)"
    }
  },
  "background": {
    "type": "html",
    "src": "background/index.html",
    "poster": "poster.jpg",
    "reduced_motion_src": "poster.jpg",
    "color": "#f6efe2"
  },
  "boot": {
    "type": "html",
    "src": "boot/index.html",
    "background": "#0b0910",
    "policy": "session",
    "skippable": true,
    "skip_after_ms": 800,
    "max_duration_ms": 9500,
    "wait_for_host": true,
    "reduced_motion": "skip",
    "exit": "fade",
    "audio": { "type": "file", "src": "boot/hive-boot.m4a", "volume": 0.6, "fade_in_ms": 150, "fade_out_ms": 900 }
  }
}
