{
  "$schema": "../workswarm-theme/schema/theme.schema.json",
  "theme_api": 1,
  "id": "workswarm-theme-aurora",
  "name": "流光极昼",
  "version": "1.0.1",
  "description": "动态背景示例：柔和流动的极光光带，并附带一段自定义 HTML 问候开场，演示沙箱开场接口。",
  "tags": ["动态背景", "开场动画", "示例"],
  "preview": "poster.svg",
  "appearance": {
    "accent": "#5b4fc4",
    "surface_opacity": 0.8
  },
  "background": {
    "type": "html",
    "src": "background/index.html",
    "poster": "poster.svg",
    "reduced_motion_src": "poster.svg",
    "color": "#eef0f7",
    "blur": 0
  },
  "boot": {
    "type": "html",
    "src": "boot/index.html",
    "background": "#f4f3fb",
    "policy": "daily",
    "skippable": true,
    "skip_after_ms": 400,
    "max_duration_ms": 6000,
    "wait_for_host": true,
    "reduced_motion": "skip",
    "exit": "fade"
  }
}
