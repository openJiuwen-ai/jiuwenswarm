{
  "package_type": "agent_template",
  "name": "scene",
  "display_name": {
    "zh": "场景设计师",
    "en": "Scene Designer"
  },
  "description": "为单个场景制作可复用的空场景图，并交回图像产物。",
  "persona": {
    "dir": "persona"
  },
  "tools": [
    {
      "file": "tools/read_node_context.py",
      "class": "ReadNodeContext"
    },
    {
      "file": "tools/generate_scene.py",
      "class": "GenerateScene"
    },
    {
      "file": "tools/submit_node_output.py",
      "class": "SubmitNodeOutput"
    }
  ],
  "rails": [
    {
      "file": "rails/node_guard.py",
      "class": "NodeGuardRail"
    }
  ],
  "skills": [
    {
      "dir": "skills/scene",
      "mode": "all"
    }
  ],
  "metadata": {
    "node_type": "scene",
    "output_kind": "image"
  }
}
