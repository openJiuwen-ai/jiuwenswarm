{
  "schemaVersion": 1,
  "package_type": "extension",
  "package": {
    "domain": "agentserver",
    "id": "example.fs-probe",
    "version": "1.0.0"
  },
  "display": {
    "name": {
      "zh": "工作区文件识别",
      "en": "FS Probe"
    },
    "description": {
      "zh": "通过 ops.fs.* 读取、写入和扫描工作区文件。",
      "en": "Reads, writes and scans workspace files through ops.fs.*."
    },
    "tags": [
      {
        "zh": "文件系统",
        "en": "Filesystem"
      },
      {
        "zh": "诊断",
        "en": "Diagnostics"
      }
    ]
  },
  "extensions": [
    {
      "id": "fs-probe",
      "runtime": "backend",
      "module": "fs_probe/extension.py"
    }
  ],
  "ui": {
    "apiVersion": 1,
    "items": [
      {
        "type": "web.slot.contribution",
        "id": "fs-probe.panel",
        "slot": "conversation.panel.right",
        "order": 30,
        "renderer": {
          "kind": "webui-tree"
        }
      }
    ]
  }
}
