{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiuwenswarm:process-cli:0.1:revision:1",
  "title": "JiuwenSwarm Process CLI protocol 0.1 revision 1",
  "x-protocol-revision": 1,
  "description": "One UTF-8 JSON input/control/output record. Validate JSONL ordering and OS exit status separately. Unknown output fields and event types are compatible additions.",
  "oneOf": [
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/query"
    },
    {
      "$ref": "#/$defs/answer"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/tool_result"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/query_result"
    }
  ],
  "$defs": {
    "workspace": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "project_dir": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "trusted_dirs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{3,50}$"
        },
        "instructions": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "allOf": [
            {
              "if": {
                "contains": {
                  "const": "*"
                }
              },
              "then": {
                "maxItems": 1
              }
            }
          ],
          "description": "Omitted: configured tools. []: no tools. ['*']: configured tools. null: invalid."
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "max_iterations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "name",
        "instructions"
      ],
      "additionalProperties": false
    },
    "host_tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "type": {
              "const": "object"
            }
          },
          "required": [
            "type"
          ]
        }
      },
      "required": [
        "name",
        "description",
        "input_schema"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "\\S"
          },
          "additionalProperties": {
            "enum": [
              "allow",
              "ask",
              "deny"
            ]
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "type": {
          "const": "run"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "input": {
          "type": "string",
          "pattern": "\\S"
        },
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/agent"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "enum": [
            "agent.work.normal",
            "agent.work.plan",
            "agent.code.normal",
            "agent.code.plan",
            null
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "skills": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "mcp": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/permissions"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_schema": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "type": {
              "const": "object"
            }
          },
          "required": [
            "type"
          ]
        },
        "max_turns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000
        },
        "max_budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "host_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/host_tool"
          }
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/workspace"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "schema_version",
        "type",
        "input"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "type": {
          "const": "query"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "operation": {
          "enum": [
            "protocol.capabilities",
            "protocol.schema",
            "session.get",
            "session.list",
            "model.list",
            "model.resolve",
            "mode.list",
            "mode.resolve",
            "permission.get",
            "mcp.validate"
          ]
        },
        "params": {
          "type": "object"
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/workspace"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "schema_version",
        "type",
        "operation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "protocol.capabilities"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            },
            "required": []
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "protocol.schema"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            },
            "required": []
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "session.get"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "session_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "session.list"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "search": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": []
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "model.list"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            },
            "required": []
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "model.resolve"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {
                  "requested": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "requested"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "mode.list"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            },
            "required": []
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "mode.resolve"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {
                  "requested": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "requested"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "permission.get"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": []
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "mcp.validate"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {
                  "references": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  }
                },
                "required": [
                  "references"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "params"
            ]
          }
        }
      ]
    },
    "answer_item": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "selected_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "custom_input": {
          "type": "string"
        },
        "card_id": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "answer": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "request_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "session_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "type": {
          "const": "answer"
        },
        "interaction_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/answer_item"
          }
        }
      },
      "required": [
        "schema_version",
        "type",
        "request_id",
        "session_id",
        "interaction_id",
        "answers"
      ],
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "request_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "type": {
          "const": "cancel"
        }
      },
      "required": [
        "schema_version",
        "type",
        "request_id"
      ],
      "additionalProperties": false
    },
    "tool_result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "request_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "session_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "type": {
          "const": "tool_result"
        },
        "call_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "result": {},
        "error": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "schema_version",
        "type",
        "request_id",
        "session_id",
        "call_id"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "result"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "result"
            ]
          }
        }
      ]
    },
    "control": {
      "oneOf": [
        {
          "$ref": "#/$defs/answer"
        },
        {
          "$ref": "#/$defs/cancel"
        },
        {
          "$ref": "#/$defs/tool_result"
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "pattern": "\\S"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true
    },
    "terminal_state": {
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "completed"
            },
            "exit_code": {
              "const": 0
            },
            "error": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "failed"
            },
            "exit_code": {
              "enum": [
                1,
                2
              ]
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "properties": {
            "status": {
              "const": "cancelled"
            },
            "exit_code": {
              "const": 130
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "properties": {
            "status": {
              "const": "timed_out"
            },
            "exit_code": {
              "const": 124
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "request_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "timed_out"
          ]
        },
        "exit_code": {
          "enum": [
            0,
            1,
            2,
            124,
            130
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "result"
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_json": {
          "type": [
            "object",
            "null"
          ]
        },
        "usage": {
          "$ref": "#/$defs/usage"
        }
      },
      "required": [
        "schema_version",
        "type",
        "sequence",
        "request_id",
        "session_id",
        "status",
        "exit_code",
        "output",
        "output_json",
        "error",
        "usage"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "$ref": "#/$defs/terminal_state"
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "session_id": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "query_result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "request_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "session_id": {
          "type": "null"
        },
        "sequence": {
          "const": 0
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "timed_out"
          ]
        },
        "exit_code": {
          "enum": [
            0,
            1,
            2,
            124,
            130
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "query_result"
        },
        "operation": {
          "enum": [
            "protocol.capabilities",
            "protocol.schema",
            "session.get",
            "session.list",
            "model.list",
            "model.resolve",
            "mode.list",
            "mode.resolve",
            "permission.get",
            "mcp.validate",
            null
          ]
        },
        "data": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "type",
        "sequence",
        "request_id",
        "session_id",
        "operation",
        "status",
        "exit_code",
        "data",
        "error"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "$ref": "#/$defs/terminal_state"
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object"
              },
              "operation": {
                "enum": [
                  "protocol.capabilities",
                  "protocol.schema",
                  "session.get",
                  "session.list",
                  "model.list",
                  "model.resolve",
                  "mode.list",
                  "mode.resolve",
                  "permission.get",
                  "mcp.validate"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              },
              "operation": {
                "const": "protocol.capabilities"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/capabilities"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              },
              "operation": {
                "const": "protocol.schema"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "$schema",
                  "$id",
                  "$defs",
                  "oneOf",
                  "x-protocol-revision"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              },
              "operation": {
                "const": "mode.list"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "modes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/mode"
                    }
                  }
                },
                "required": [
                  "modes"
                ],
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
