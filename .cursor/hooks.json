{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/kb_session_start.py",
        "timeout": 15
      }
    ],
    "preCompact": [
      {
        "command": "python3 .cursor/hooks/kb_pre_compact.py",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 .cursor/hooks/kb_session_end.py",
        "timeout": 10
      }
    ]
  }
}

