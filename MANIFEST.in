# 包含 package resources 目录
recursive-include jiuwenswarm/resources *
include jiuwenswarm/agents/harness/common/rsi/harness_config.yaml
include OPEN_SOURCE_SOFTWARE_NOTICE.md
include third_party/playwright-mcp/package.json
include third_party/playwright-mcp/package-lock.json
prune jiuwenswarm/resources/agent/workspace/skills/project-maintainer

# DesignRail 内嵌声明式状态机 config.yaml + 内嵌 skills 方法论（wave-1 SDD）
recursive-include jiuwenswarm/agents/harness/code/rails/sdd/design_rail *.yaml
recursive-include jiuwenswarm/agents/harness/code/rails/sdd/design_rail/skills *

# Designer 内嵌 skills（scenarios / agents / orchestration / subjects / styles + index.json）
recursive-include jiuwenswarm/server/runtime/designer/skills *

# 排除 node_modules，避免打包进 wheel
prune jiuwenswarm/channels/web/frontend/node_modules
global-exclude node_modules

# Runtime inputs used by the task-owned cua_repl subprocess.
include jiuwenswarm/cua_engine/__init__.py
include jiuwenswarm/cua_engine/hosting.py
include jiuwenswarm/cua_engine/desktop.py
include jiuwenswarm/cua_engine/artifacts.py
include jiuwenswarm/cua_engine/pyproject.toml
include jiuwenswarm/cua_engine/backends/macos/Package.swift
recursive-include jiuwenswarm/cua_engine/src *.py *.pyi
recursive-include jiuwenswarm/cua_engine/backends/macos/Sources *.swift
recursive-include jiuwenswarm/cua_engine/backends/windows *.cs *.json
recursive-include jiuwenswarm/cua_engine/assets *.svg *.json
recursive-include jiuwenswarm/cua_engine/skills *.md
