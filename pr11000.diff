diff --git a/jiuwenswarm/agents/harness/flash/prompt/content/relay.py b/jiuwenswarm/agents/harness/flash/prompt/content/relay.py
index 3e763d3504f0a516347fc8af9e12ef73cd0f031b..54df8a34b896f661b46cc9cbddae61df5101c453 100644
--- a/jiuwenswarm/agents/harness/flash/prompt/content/relay.py
+++ b/jiuwenswarm/agents/harness/flash/prompt/content/relay.py
@@ -65,3 +65,70 @@ def _strip_relay_duplicates(content: str) -> str | None:
             return None
 
     return (content[:ws_idx] + content[mc_idx:]).rstrip()
+
+
+# ── workspace 实时副本已注入时，剥除 relay 的 SOUL.md / AGENT.md 静态副本 ──────
+# 引擎 ContextAssembleRail（priority 85，先于本 rail）把 workspace 的 SOUL.md / AGENT.md
+# 条件注入为 ``context.soul`` / ``context.agent``（文件存在且非空/非模板才注入）。两者同时
+# 进模型会让同一份身份出现「静态副本 + 实时副本」两版；以实时副本为准，且**仅在其存在时**
+# 才剥 relay 副本——workspace 没有该文件时，relay 副本可能是唯一来源，剥了会丢身份。
+_CONTEXT_BLOCK_ANCHORS = {
+    "SOUL.md": re.compile(r"(?m)^##(?!#)[ \t]+SOUL\.md(?:[ \t]+[-—].*)?[ \t]*$"),
+    "AGENT.md": re.compile(r"(?m)^##(?!#)[ \t]+AGENT\.md(?:[ \t]+[-—].*)?[ \t]*$"),
+}
+
+# 块结束边界：下一个 H2 标题，或 relay 顶层分区标题（``[xxx]`` 独占一行），或段尾。
+_CONTEXT_BLOCK_END = re.compile(r"(?m)^(?:##(?!#)[ \t]+\S|\[[^\]\n]+\][ \t]*$)")
+
+
+def _strip_context_block(text: str, file_key: str) -> tuple[str, str]:
+    """剥除 relay 里的 ``## SOUL.md`` / ``## AGENT.md`` 整块，返回 ``(new_text, status)``。
+
+    ``status``：``dropped``（命中并剥除）/ ``absent``（relay 无该块，正常）/ 不返回失败态——
+    块尾按 markdown 语义取下一个 H2 / relay 分区标题；找不到则视为延伸到段尾。
+    """
+    anchor = _CONTEXT_BLOCK_ANCHORS.get(file_key)
+    if anchor is None:
+        return text, "absent"
+    match = anchor.search(text)
+    if match is None:
+        return text, "absent"
+
+    end_match = _CONTEXT_BLOCK_END.search(text, match.end())
+    end = end_match.start() if end_match is not None else len(text)
+    head = text[:match.start()].rstrip()
+    tail = text[end:].lstrip() if end < len(text) else ""
+    if head and tail:
+        return f"{head}\n\n{tail}", "dropped"
+    return (head or tail), "dropped"
+
+
+# ── relay [记忆纠正规则] 第 6 条：删除=回收站 —— 120 已完整覆盖 ────────────────
+# 120 删除规范含「大文件同卷软删除回退」例外，relay 第 6 条是缺例外的简版；两版并存时
+# 模型可能只按简版执行，故删 relay 侧副本。按「行首编号 + 关键短语」定位，编号漂移也能命中。
+_MEMORY_RULE6_MARKER = "移入回收站即为合规的软删除"
+_MEMORY_RULE6_LINE = re.compile(r"^[ \t]*\d+[.、][ \t]*")
+
+
+def _strip_memory_rule6(text: str) -> tuple[str, bool]:
+    """删 ``[记忆纠正规则]`` 的删除=回收站一条，返回 ``(new_text, hit)``。"""
+    lines = text.split("\n")
+    for index, line in enumerate(lines):
+        if _MEMORY_RULE6_MARKER in line and _MEMORY_RULE6_LINE.match(line):
+            del lines[index]
+            return "\n".join(lines), True
+    return text, False
+
+
+def _rewrite_memory_tool_names(text: str, replacements) -> tuple[str, bool]:
+    """把 relay 块里的旧记忆工具名改写为统一入口，返回 ``(new_text, hit)``。
+
+    映射表由调用方注入（取 ``memory_names.MEMORY_NAME_REPLACEMENTS``，与
+    FlashMemoryRail 共用同一份）；best-effort：没有旧名即原样返回，不阻断其它改写。
+    """
+    hit = False
+    for old, new in replacements or ():
+        if old in text:
+            text = text.replace(old, new)
+            hit = True
+    return text, hit
