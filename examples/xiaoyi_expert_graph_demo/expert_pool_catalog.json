                "id": "presentation-brief.json",
                "mediaType": "application/json",
                "schema": "xiaoyi.presentation-brief.v1",
                "visibility": "internal"
              }
            ],
            "outputs": [
              {
                "id": "presentation-deck.json",
                "mediaType": "application/json",
                "schema": "xiaoyi.presentation-deck.v1",
                "visibility": "internal"
              },
              {
                "id": "presentation.html",
                "mediaType": "text/html",
                "schema": "xiaoyi.rendered-html.v1",
                "primary": true,
                "visibility": "public"
              }
            ]
