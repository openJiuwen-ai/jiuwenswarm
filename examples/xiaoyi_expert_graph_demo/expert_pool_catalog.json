{
  "version": "xiaoyi.expert-pool-catalog.v1",
  "defaults": {
    "member": {
      "enabled": true,
      "collaboration": {
        "contractVersion": "xiaoyi.expert-collaboration.v1",
        "reusable": true
      }
    }
  },
  "teams": {
    "humanize-ppt-team": {
      "categoryId": "06-ContentCreative",
      "tags": ["PPT", "演示设计", "内容创作"],
      "members": {
        "outline-director": {
          "displayName": "PPT大纲导演",
          "description": "把零散资料整理成叙事清楚、重点突出的演示大纲和页面结构。",
          "quickPrompt": "把这份材料整理成一套适合向领导汇报的PPT大纲。",
          "skills": ["humanize-ppt"],
          "deliverables": ["可直接进入视觉制作的演示大纲", "逐页信息结构"],
          "collaboration": {
            "outputs": [
              {
                "id": "presentation-brief.json",
                "mediaType": "application/json",
                "schema": "xiaoyi.presentation-brief.v1",
                "description": "含受众、叙事主线、逐页结构和素材边界的演示交接单",
                "visibility": "internal"
              },
              {
                "id": "presentation-outline.html",
                "mediaType": "text/html",
                "schema": "xiaoyi.rendered-html.v1",
                "description": "可浏览评审的PPT大纲",
                "primary": true,
                "visibility": "public"
              }
            ]
          }
        },
        "guizang-renderer": {
          "displayName": "中文PPT生成师",
          "description": "根据演示大纲生成中文排版稳定、可直接展示的HTML幻灯片。",
          "quickPrompt": "把这份大纲做成一套简洁专业的中文PPT。",
          "skills": ["guizang-ppt-skill"],
          "deliverables": ["中文HTML幻灯片"],
