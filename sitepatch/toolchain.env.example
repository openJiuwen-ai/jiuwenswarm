# 由 install-ohos-all-deps.sh 在 pip 安装时自动生成 sitepatch/toolchain.env（勿手改）
# 机器路径请在 scripts/ohos/ohos-env.local.sh 配置，安装脚本会写入下方变量。
#
# 生成示例:
# WHEEL_BUILD_ROOT=/path/to/jiuwenswarm
# OHOS_HNP_ROOT=/data/service/hnp
# OHOS_HNP_BIN=/data/service/hnp/bin
# OHOS_LLVM_BIN=/data/service/hnp/ohos-sdk.org/ohos-sdk_*/ohos/native/llvm/bin
# OHOS_RUST_BIN=$HOME/usr/rust-1.95.0-aarch64-unknown-linux-ohos/bin
# OHOS_USR_LOCAL=$HOME/usr/local
# OHOS_STORAGE_ROOT=/storage/Users/currentUser
# RUSTC=...
# CARGO=...
# CC=...
# OPENSSL_DIR=...
# PKG_CONFIG_PATH=...
# LD_LIBRARY_PATH=...
# PATH=...
