ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root
ARG PIP_EXTRA_ARGS="-i https://mirrors.aliyun.com/pypi/simple/"
ARG AGENT_PROTOCOL_REPOS=https://gitcode.com/openJiuwen/agent-protocol.git
ARG AGENT_PROTOCOL_COMMIT=10ad4a2eeff11e0600c06a8235a797c5dd9f0a38

# Keep dependencies outside the source mount and do not install the Swarm project.
COPY docker/requirements-user-backend.txt /tmp/requirements-user-backend.txt
RUN python3 -m venv /opt/user-backend-env \
    && /opt/user-backend-env/bin/python -m pip install --no-cache-dir \
        -r /tmp/requirements-user-backend.txt ${PIP_EXTRA_ARGS} \
    && /opt/user-backend-env/bin/python -m pip install --no-cache-dir --no-deps \
        "openjiuwen-e2a @ git+${AGENT_PROTOCOL_REPOS}@${AGENT_PROTOCOL_COMMIT}#subdirectory=openjiuwen-e2a" ${PIP_EXTRA_ARGS} \
    && rm /tmp/requirements-user-backend.txt

WORKDIR /app/jiuwenswarm
COPY LICENSE OPEN_SOURCE_SOFTWARE_NOTICE.md ./
COPY jiuwenswarm/__init__.py ./jiuwenswarm/
COPY jiuwenswarm/channels/__init__.py ./jiuwenswarm/channels/
COPY jiuwenswarm/channels/web/__init__.py \
    jiuwenswarm/channels/web/enterprise_backend.py jiuwenswarm/channels/web/enterprise_catalog.py \
    ./jiuwenswarm/channels/web/

ENV HOME=/tmp \
    PATH=/opt/user-backend-env/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    JIUWENSWARM_EDITION=enterprise
USER 1000:0
EXPOSE 8780
CMD ["/opt/user-backend-env/bin/python", "-m", "uvicorn", "jiuwenswarm.channels.web.enterprise_backend:create_app", "--factory", "--host", "0.0.0.0", "--port", "8780", "--no-access-log"]
