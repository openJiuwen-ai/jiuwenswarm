ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root
ARG PIP_EXTRA_ARGS="-i https://mirrors.aliyun.com/pypi/simple/"

WORKDIR /app/jiuwenswarm
COPY pyproject.toml uv.lock setup.py MANIFEST.in README.md LICENSE OPEN_SOURCE_SOFTWARE_NOTICE.md ./
COPY scripts/build_config.py scripts/release_dependencies.py ./scripts/
COPY jiuwenswarm ./jiuwenswarm/
COPY jiuwenbox/src ./jiuwenbox/src/
RUN uv pip install --system . ${PIP_EXTRA_ARGS}

ENV HOME=/tmp \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    JIUWENSWARM_EDITION=enterprise
USER 1000:0
EXPOSE 8780
CMD ["python3", "-m", "uvicorn", "jiuwenswarm.channels.web.app_web:create_enterprise_app", "--factory", "--host", "0.0.0.0", "--port", "8780", "--no-access-log"]
