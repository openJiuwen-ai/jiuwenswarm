ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG AGENT_RUNTIME_REPOS
ARG AGENT_RUNTIME_BRANCH
ARG PIP_EXTRA_ARGS="-i https://mirrors.aliyun.com/pypi/simple/"

RUN useradd --create-home --shell /bin/bash app \
    && mkdir -p /app/jiuwenswarm && chown app:app /app/jiuwenswarm

WORKDIR /app/jiuwenswarm
COPY --chown=app:app . /app/jiuwenswarm/

RUN sed -i '/openjiuwen_runtime_foundation/d' pyproject.toml
RUN sed -i '/openjiuwen_runtime_management/d' packages/jiuwenclaw-ee/gateway/extensions/runtime_management_extension/pyproject.toml

# 构建期使用 uv（运行时 ExtensionLoader 同样依赖）；要求构建机 docker >= 20.10.10
RUN uv pip install --system \
    -e . \
    git+${AGENT_RUNTIME_REPOS}@${AGENT_RUNTIME_BRANCH}#subdirectory=foundation \
    git+${AGENT_RUNTIME_REPOS}@${AGENT_RUNTIME_BRANCH}#subdirectory=management \
    "rich>=13.7.0" \
    ${PIP_EXTRA_ARGS}

# Prefetch tiktoken BPE at build time (avoids sync download on first request).
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache
RUN mkdir -p /opt/tiktoken-cache \
    && python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')" \
    && chown -R app:app /opt/tiktoken-cache \
    && chmod -R u+rwX,go+rX /opt/tiktoken-cache

RUN yq -y -i '.dependencies = {}' jiuwenswarm/extensions/symphony/extension.yaml

# 预建 workspace（app 属主）：product 模式 gateway/agentserver 以 app 运行，
# kubelet 为 config subPath 挂载创建的中间目录是 root 属主，运行期会 EACCES
RUN mkdir -p /home/app/.jiuwenswarm/config && chown -R app:app /home/app/.jiuwenswarm

USER app
ENV PATH=$PATH:/home/app/.local/bin

# 启动入口：按 ROLE 环境变量决定运行 gateway / agentserver（见 docker/start.sh）
CMD ["/app/jiuwenswarm/docker/start.sh"]
