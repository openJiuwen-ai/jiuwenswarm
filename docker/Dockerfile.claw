ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG AGENT_RUNTIME_REPOS=https://gitcode.com/openJiuwen/agent-runtime.git
ARG AGENT_RUNTIME_BRANCH=develop
ARG AGENT_CORE_REPOS=https://gitcode.com/openJiuwen/agent-core.git
# agent-core 用 commit 钉死，不跟踪分支
ARG AGENT_CORE_COMMIT=1b066729e6159aa149fe9bdc2c31ec1778e2a681
ARG AGENT_PROTOCOL_REPOS=https://gitcode.com/openJiuwen/agent-protocol.git
# 与 pyproject / gateway 对齐：openjiuwen-e2a@10ad4a2（含 MULTIMODAL_*）；旧 subdirectory=e2a 会构建失败。
ARG AGENT_PROTOCOL_COMMIT=10ad4a2eeff11e0600c06a8235a797c5dd9f0a38
ARG PIP_EXTRA_ARGS="-i https://mirrors.aliyun.com/pypi/simple/"

# uid/gid 固定 1000：与部署侧 CLAW_USER/CLAW_GROUP/CLAW_FS_GROUP(=1000) 及
# k8s 模板渲染的 runAsUser/runAsGroup 硬契约对齐；基础镜像若已占用 1000
# 会在构建期直接失败（fail fast），避免运行期属主漂移导致 EACCES
RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash app \
    && mkdir -p /app/jiuwenswarm /app/config \
    && chown -R app:app /app

WORKDIR /app/jiuwenswarm
COPY --chown=app:app . /app/jiuwenswarm/

# 删除源码依赖声明，改由 AGENT_CORE_*/AGENT_PROTOCOL_*/AGENT_RUNTIME_* 构建参数安装。
# 必须同时清 dependencies/overrides（含 openjiuwen[extra]）与 [tool.uv.sources]，
# 否则 uv 可能静默丢掉 CLI 的裸 openjiuwen（镜像无包、运行期 ModuleNotFoundError）。
# e2a / openjiuwen-e2a：协议仓改名前后两种声明都要删，避免与下方 ARG 双装。
RUN sed -E -i \
    -e '/^[[:space:]]*"openjiuwen(\[|"| @ |[>=<!~;])/d' \
    -e '/^[[:space:]]*"e2a(\[|"| @ |[>=<!~;])/d' \
    -e '/^[[:space:]]*"openjiuwen-e2a(\[|"| @ |[>=<!~;])/d' \
    -e '/^[[:space:]]*"openjiuwen-runtime-foundation(\[|"| @ |[>=<!~;])/d' \
    -e '/^[[:space:]]*"openjiuwen-runtime-management(\[|"| @ |[>=<!~;])/d' \
    -e '/^[[:space:]]*openjiuwen[[:space:]]*=/d' \
    -e '/^[[:space:]]*e2a[[:space:]]*=/d' \
    -e '/^[[:space:]]*openjiuwen-e2a[[:space:]]*=/d' \
    -e '/^[[:space:]]*openjiuwen-runtime-foundation[[:space:]]*=/d' \
    -e '/^[[:space:]]*openjiuwen-runtime-management[[:space:]]*=/d' \
    pyproject.toml \
 && if grep -Eq '^[[:space:]]*("(openjiuwen-runtime-foundation|openjiuwen-runtime-management|openjiuwen-e2a|openjiuwen|e2a)(\[|"| @ |[>=<!~;])|(openjiuwen-runtime-foundation|openjiuwen-runtime-management|openjiuwen-e2a|openjiuwen|e2a)[[:space:]]*=)' pyproject.toml; then \
      echo "[docker] pyproject 仍钉着 CLI 注入包（openjiuwen/e2a|openjiuwen-e2a/runtime-*），AGENT_CORE_*/AGENT_PROTOCOL_*/AGENT_RUNTIME_* 会被 uv 丢掉" >&2; \
      grep -nE 'openjiuwen|e2a' pyproject.toml >&2 || true; \
      exit 1; \
    fi

RUN if [ -f jiuwenswarm/extensions/runtime_management_extension/pyproject.toml ]; then \
        sed -i '/openjiuwen_runtime_management/d' jiuwenswarm/extensions/runtime_management_extension/pyproject.toml; \
    fi

RUN uv pip install --system \
    -e . \
    "openjiuwen @ git+${AGENT_CORE_REPOS}@${AGENT_CORE_COMMIT}" \
    "openjiuwen-e2a @ git+${AGENT_PROTOCOL_REPOS}@${AGENT_PROTOCOL_COMMIT}#subdirectory=openjiuwen-e2a" \
    "openjiuwen-runtime-foundation @ git+${AGENT_RUNTIME_REPOS}@${AGENT_RUNTIME_BRANCH}#subdirectory=foundation" \
    "openjiuwen-runtime-management @ git+${AGENT_RUNTIME_REPOS}@${AGENT_RUNTIME_BRANCH}#subdirectory=management" \
    "rich>=13.7.0" \
    ${PIP_EXTRA_ARGS}

# Prefetch tiktoken BPE at build time (avoids sync download on first request).
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache
RUN mkdir -p /opt/tiktoken-cache \
    && python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')" \
    && chown -R app:app /opt/tiktoken-cache \
    && chmod -R u+rwX,go+rX /opt/tiktoken-cache

RUN if [ -f jiuwenswarm/extensions/symphony/extension.yaml ]; then \
        yq -y -i '.dependencies = {}' jiuwenswarm/extensions/symphony/extension.yaml; \
    fi

USER app
ENV PATH=$PATH:/home/app/.local/bin

# 启动入口：按 ROLE 环境变量决定运行 gateway / agentserver（见 docker/start.sh）
CMD ["/app/jiuwenswarm/docker/start.sh"]
