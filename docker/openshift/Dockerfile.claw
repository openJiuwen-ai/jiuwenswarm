ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root

ARG AGENT_RUNTIME_REPOS=https://gitcode.com/openJiuwen/agent-runtime.git
ARG AGENT_RUNTIME_BRANCH=develop
ARG AGENT_CORE_REPOS=https://gitcode.com/openJiuwen/agent-core.git
ARG AGENT_CORE_COMMIT=f3f8f576164cc405c046e43079c8ad00ee17f0c4
ARG AGENT_PROTOCOL_REPOS=https://gitcode.com/openJiuwen/agent-protocol.git
ARG AGENT_PROTOCOL_COMMIT=4c5f3e9eb41bd33d34d012b06a3e364e8497ac11
ARG AGENT_GATEWAY_REPOS=https://gitcode.com/openJiuwen/agent-gateway.git
ARG AGENT_GATEWAY_BRANCH=develop
ARG PIP_EXTRA_ARGS="-i https://mirrors.aliyun.com/pypi/simple/"

# 业务用户 app(1000)
RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash app \
    && mkdir -p /app/jiuwenswarm /app/config /opt/tiktoken-cache \
    && chown 1000:0 /app/jiuwenswarm /app/config /opt/tiktoken-cache /home/app \
    && chmod -R g+rwX /app/jiuwenswarm /app/config /opt/tiktoken-cache /home/app

WORKDIR /app/jiuwenswarm
COPY --chown=1000:0 . /app/jiuwenswarm/
RUN chgrp -R 0 /app/jiuwenswarm && chmod -R g+rwX /app/jiuwenswarm

# 删除源码依赖声明，URL 由下方 CLI 构建参数提供
RUN sed -E -i \
    -e '/^[[:space:]]*"openjiuwen("| @|[<>=!~;])/d' \
    -e '/^[[:space:]]*"openjiuwen-protocol("| @|[<>=!~;])/d' \
    -e '/^[[:space:]]*"openjiuwen-runtime-foundation("| @|[<>=!~;])/d' \
    -e '/^[[:space:]]*"openjiuwen-runtime-management("| @|[<>=!~;])/d' \
    -e '/^[[:space:]]*"agent-gateway("| @|[<>=!~;])/d' \
    pyproject.toml
RUN if [ -f packages/jiuwenclaw-ee/gateway/extensions/runtime_management_extension/pyproject.toml ]; then \
        sed -i '/openjiuwen_runtime_management/d' packages/jiuwenclaw-ee/gateway/extensions/runtime_management_extension/pyproject.toml; \
    fi

# agent-gateway 独立仓按构建参数取源（BRANCH 可为分支 / tag / commit：先浅取，
# 服务器不支持按 commit 取时回退全量），并从其 pyproject 删除源码依赖声明；
# clone 与安装须在同一 RUN，跨层 rm 无法回收上一层已提交的源码树与 .git
RUN git init -q /tmp/build/agent-gateway \
    && git -C /tmp/build/agent-gateway remote add origin "${AGENT_GATEWAY_REPOS}" \
    && if git -C /tmp/build/agent-gateway fetch -q --depth 1 origin "${AGENT_GATEWAY_BRANCH}" 2>/dev/null; then \
        git -C /tmp/build/agent-gateway checkout -q --detach FETCH_HEAD; \
    else \
        git -C /tmp/build/agent-gateway fetch -q origin "+refs/heads/*:refs/remotes/origin/*" "+refs/tags/*:refs/tags/*" \
        && git -C /tmp/build/agent-gateway checkout -q --detach "${AGENT_GATEWAY_BRANCH}"; \
    fi \
    && sed -E -i \
        -e '/^[[:space:]]*"openjiuwen("| @|[<>=!~;])/d' \
        -e '/^[[:space:]]*"openjiuwen-protocol("| @|[<>=!~;])/d' \
        -e '/^[[:space:]]*"openjiuwen-runtime-foundation("| @|[<>=!~;])/d' \
        -e '/^[[:space:]]*"openjiuwen-runtime-management("| @|[<>=!~;])/d' \
        /tmp/build/agent-gateway/pyproject.toml \
    && uv pip install --system \
        -e . \
        "openjiuwen @ git+${AGENT_CORE_REPOS}@${AGENT_CORE_COMMIT}" \
        "openjiuwen-protocol @ git+${AGENT_PROTOCOL_REPOS}@${AGENT_PROTOCOL_COMMIT}#subdirectory=openjiuwen-protocol" \
        "openjiuwen-runtime-foundation @ git+${AGENT_RUNTIME_REPOS}@${AGENT_RUNTIME_BRANCH}#subdirectory=foundation" \
        "openjiuwen-runtime-management @ git+${AGENT_RUNTIME_REPOS}@${AGENT_RUNTIME_BRANCH}#subdirectory=management" \
        /tmp/build/agent-gateway \
        "rich>=13.7.0" \
        ${PIP_EXTRA_ARGS} \
    && rm -rf /tmp/build

# tiktoken BPE 预热
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"

# symphony extension.yaml 存在才清理依赖
RUN if [ -f jiuwenswarm/extensions/symphony/extension.yaml ]; then \
        yq -i '.dependencies = {}' jiuwenswarm/extensions/symphony/extension.yaml; \
    fi

ENV HOME=/home/app \
    PATH=/usr/local/bin:$PATH:/home/app/.local/bin

CMD ["/app/jiuwenswarm/docker/start.sh"]
